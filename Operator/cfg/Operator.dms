////////////////////////////////////////////////////////////////////////////////////////////////////////////////
//                                                                                                            //
//                              Operator/Functie Test                                                         //
//                                                                                                            //
//                  Configuratie voor het testen van de DMS Operatoren/Functies                               //
//                  Geschreven in het kader van het project: Beheer RuimteScanner                             //
//                                                                                                            //
//                                       Februari 2004                                                        //
//                                                                                                            //
//                             Continue aanpassingen voor nieuwe operatoren                                   //
//                                                                                                            //
////////////////////////////////////////////////////////////////////////////////////////////////////////////////

container OperatorTest: url = "%projdir%/doc/test.htm", FreeData = "True"
{
	container gui_lander;
	#include <results.dms>

	// gebruikte domain-units (aantallen-domeinen, grids en hun tiled varianten)
	#include <Domains.dms>

	// gebruikte values-units
	#include <Units.dms>

	// vergelijkingsparameters voor floating point items
	#include <Tolerances.dms>

	#include <MetaInfo.dms>
	// Versie-afhankelijke test-selectie (zie MetaInfo/OperatorList = DocData()):
	// een Spec-rij is 'pad/naar/test_bool' (draait altijd), 'pad|operator1[;operator2]'
	// (draait alleen als de genoemde operator(en) in deze GeoDMS-versie bestaan;
	// NB: metascript-constructies zoals for_each staan NIET in de OperatorList en
	// mogen dus nooit als vereiste worden opgegeven), of 'AGG|pad/naar/results'
	// (telt een onderliggende results-container met tests/nrExecuted/nrConfigured mee).
	// Paden worden letterlijk in de opgebouwde expressie gezet en resolven dus in de
	// context van het tests-item naast de instantiatie (naamresolutie zoekt omhoog),
	// precies zoals de oorspronkelijke &&-kettingen. Zie ook de wiki:
	// Test-references-and-report-generation.
	#include <TestSet.dms>

	#include <Classifications.dms>
	// Thema-containers met per operator een testcontainer. De naamgeving dateert
	// van 2004 en wijkt deels af van de wiki-indeling "Operators and Functions"
	// (github.com/ObjectVision/GeoDMS/wiki):
	//   Arithmetics=Arithmetic, Aggregations=Aggregation, Constants=Constant,
	//   UnitFunctions=Unit, Point~Geometric (geometrie staat deels ook in Sequence),
	//   File+ReadAVLE~"File, Folder and Read", selectie-operatoren staan in
	//   Relational (wiki: Selection). Precedence/Trackers/ExplicitNullvalues/
	//   Utf8Characters zijn taal-/syntaxtests zonder wiki-categorie.
	// Hernoemen naar de wiki-namen kan, maar Arithmetics en Aggregations worden
	// extern gerefereerd (t1742-statistics resp. t1640-value_info incl. hun
	// referentiebestanden in TestReferenceFiles) - dat vergt een bewuste
	// her-capture van die referenties.
	#include <Arithmetics.dms>
	/* Currently not supported
	container arithmetic_uint2_4_8
	{
		container source
		{
			attribute<uint32> plusUint2 (Adomain): [0,0,1,1,1];
		}
		container plusUint2
		{
			attribute<uint2>   att  (ADomain) := Conversion/UInt2/att_bool + Conversion/UInt2/att_int;
			attribute<bool>    test (ADomain) := att = source/plusUint2; 
			parameter<bool>    test_attr     := all(test);
		}
	}
	*/
	#include <Precedence.dms>
	#include <Ordering.dms>
	#include <Transcendental.dms>
	#include <Conversion.dms>
	#include <Aggregations.dms>
	#include <Predicates.dms>
	#include <Logical.dms>
	#include <Relational.dms>
	#include <Classify.dms>
	#include <Rescale.dms>
	#include <Constants.dms>
	#include <Trigonometric.dms>
	#include <Point.dms>
	#include <Sequence.dms>
	#include <Network.dms>
	#include <Grid.dms>
	#include <Matrix.dms>
	#include <string.dms>
	#include <File.dms>
	#include <ReadAVLE.dms>
	#include <MetaScript.dms>
	#include <ForEach.dms>
	#include <Allocation.dms>
	#include <UnitFunctions.dms>
	#include <Miscellaneous.dms>
	#include <Trackers.dms>
	
	#include <ExplicitNullvalues.dms>
	
	#include <Utf8Characters.dms>

}
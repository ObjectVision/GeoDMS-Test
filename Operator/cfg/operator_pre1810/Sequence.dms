					,	'StringToSequence/tests/param_int32/test|int32seq'
					,	'StringToSequence/tests/param_int16/test|int16seq'
					,	'StringToSequence/tests/param_int8/test|int8seq'
					,	'StringToSequence/tests/param_float64/test|float64seq'
					,	'StringToSequence/tests/param_float32/test|float32seq'
					,	'bg_simplify/test_attr'
					,	'bg_simplify/tests/Circle/test_attr'
					,	'bg_buffer_multi_point/test_attr'
					,	'bg_buffer_linestring/test_attr'
					,	'bg_buffer_single_polygon/test_attr'
					,	'bg_buffer_multi_polygon/test_attr'
					,	'bg_outer_single_polygon/test_attr'

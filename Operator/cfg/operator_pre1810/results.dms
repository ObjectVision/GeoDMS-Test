		container selection := TestSet(Cand, Cand/Spec);
		parameter<bool>   tests_regression  := =selection/test_expr;
		parameter<uint32> nrTestsExecuted   := =selection/count_expr;
		parameter<uint32> nrTestsConfigured := =selection/conf_expr;
		parameter<string> failing_tests     := =selection/fail_expr;
		parameter<string> skipped_tests     := =selection/skip_expr;

		unit<uint32> resDomain: nrofrows = 1;
		attribute<uint32> testsExp(resDomain) :=  const(uint32(tests_all), resDomain)
		,	StorageName = "regr_res.dbf"; 

		parameter<string> tests_log := String(tests_regression)
		,	StorageType = "str"
		,	storagename = "%localDataProjDir%/regr_results/operator.txt";


		parameter<string> unit_test_log := tests_regression
			? ''
			: 'Operator Test: ' + expand(., '%configDir%') + '.dms ' + PropValue(tests_regression, 'fullname') + ' result: not OK; failing: ' + failing_tests
		,	StorageType = "str"
		,	storagename = "%localDataDir%/GeoDMSTestResults/unit/operator/operator.txt";

		container Regression
		{
			parameter<string> TempDir                  := '';
			parameter<string> results_folder_filename  := '%LocalDataDir%/Regression/log/results_folder.txt';
			parameter<string> results_folder           :  Storagename =  "= results_folder_filename", StorageType = "str";

			// (Subitems/nrTests strcount-telling vervangen door exacte telling nrTestsExecuted/nrTestsConfigured)

			container t010_operator_test
			{
				parameter<string> result := 
					'<description>operator test</description>' + 
					'<size>number of tests executed: ' + string(nrTestsExecuted) + ' of ' + string(nrTestsConfigured) + ' configured</size>' + 
					'<result>' + (tests_regression ? 'OK' : 'False') + '</result>' + 
					(failing_tests = '' ? '' : '<failing>' + failing_tests + '</failing>') + 
					(skipped_tests = '' ? '' : '<skipped>' + skipped_tests + '</skipped>');

				parameter<string> stored_result := result, StorageType = "str", Storagename = "= results_folder + '/t010_operator_test.txt'";

				// dump van alle operator-groepen in deze versie; het rapport combineert
				// dit met de Spec-rijen tot een dekkingsregel + t010_operator_coverage.txt
				parameter<string> operator_groups := asList(MetaInfo/OperatorList/OperatorGroups/Name, ';')
				,	StorageType = "str", Storagename = "= results_folder + '/t010_operator_groups.txt'";
			}
		}

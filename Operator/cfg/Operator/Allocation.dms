	container Allocation: url = "http://www.objectvision.nl/geodms/operators-a-functions/allocation", Using = "/Domains;/Units;/Tolerances"
	{
		unit<fpoint>  TestCoords := Range(point_yx(100f, 0f), point_yx(600f, 600f));
		unit<float32> Meter      := BaseUnit('m', float32);
		unit<float32> Meter2     := Meter * Meter;
		unit<float32> Ha         := 10000.0 * Meter2;
		parameter<float32> gridsize := 500f;
		
		unit<spoint> DomainGrid :=
				range(
				  gridset(
					fpoint, 
					point_yx(-gridsize, gridsize, TestCoords), 
					point_yx(625000f, 10000f, TestCoords), 
					spoint
				  ),
				  point_yx(int16(0), int16(0))
				, point_yx(int16(6), int16(6))
				),
			DialogType = "Map" 
		{
			parameter<meter2> NrMeter2PerCell := gridsize[meter] * gridsize[meter];
			parameter<ha>     NrHaPerCell     := convert(NrMeter2PerCell, ha);
		}

		unit<spoint> EDomainGrid :=
				range(
				  gridset(
					fpoint, 
					point_yx(-gridsize, gridsize, TestCoords), 
					point_yx(float32(625000.0), float32(10000.0), TestCoords), 
					spoint
				  ),
				  point_yx(int16(0), int16(0))
				, point_yx(int16(0), int16(0))
				),
			DialogType = "Map"
		{
			parameter<meter2> NrMeter2PerCell := gridsize[meter] * gridsize[meter];
			parameter<ha>     NrHaPerCell     := convert(NrMeter2PerCell, ha);
		}

		container source
		{
			unit<float32> EurM2;

			attribute<lu_type> landuse (DomainGrid):
			[
			 2, 2, 2, 1, null, null,
			 2, 2, 0, 0, null, 1,
			 2, 0, 0, 1,    1, 1,
			 2, 0, 0, 0,    1, 1,
			 2, 0, 0, 1, null, 1,
			 2, 2, 2, 2,    2, 2
			];
			unit <uint8> lu_type: nrofrows = 3
			{
				attribute<string>  Name:           [ 'Living', 'Working', 'Nature' ], DialogType = "LabelText";
				attribute<string>  PartioningName: [ 'Living', 'Working', 'Nature' ];
				attribute<lu_type> partioning := id(lu_type);
				attribute<uint32>  BrushColor: [rgb(200,0,0),rgb(100,100,100),rgb(0,200,0)], DialogType = "BrushColor";
			}
			container SuitabilityMaps
			{
				attribute<EurM2> Living  (DomainGrid):
				[
				 1,  2,  5, 4,  3, -1,
				 2,  5,  8, 9,  7, 3,
				 4, 10, 12,13, 12, 6,
				 5, 11, 13,14, 12, 6,
				 4,  9,  9, 5,  3, 2,
				 2,  2,  4, 3,  1, 1
				];
				attribute<EurM2> Working (DomainGrid):
				[
				 1, 1, 2, 3,  4, -6,
				 2, 3, 4, 6,  8, 9,
				 2, 4, 9,11, 12,10,
				 1, 3, 5, 9, 10, 6,
				 2, 4, 5, 5,  3, 2,
				 1, 1, 2, 1,  1, 1
				];
				attribute<EurM2> Nature  (DomainGrid):
				[
				 3, 3, 3, 2, 2, -2,
				 3, 3, 2, 2, 2, 2,
				 3, 2, 1, 1, 1, 1,
				 3, 2, 1, 1 ,1, 2,
				 3, 3, 2, 1, 2, 2,
				 3, 3, 3, 3, 3, 3
				];
			}
			container regMaps
			{
				unit <uint8> p1: nrofrows = 1;
				unit <uint8> p2: nrofrows = 2;

				attribute<p1> p1Map (DomainGrid) := const(0, DomainGrid, p1);
				attribute<p2> p2Map (DomainGrid) := pointRow(ID(DomainGrid)) < int16(4) ? value(0,p2) : value(1,p2);
			}
			container claim_sources
			{
				container p1
				{
					attribute<uint32> Nature_min (regMaps/p1) := const(12, regMaps/p1);
					attribute<uint32> Nature_max (regMaps/p1) := const(20, regMaps/p1);
					attribute<uint32> Living_min (regMaps/p1) := const(5, regMaps/p1);
					attribute<uint32> Living_max (regMaps/p1) := const(9, regMaps/p1);
				}
				container p2
				{
					attribute<uint32> Working_min (regMaps/p2) : [6, 2];
					attribute<uint32> Working_max (regMaps/p2) : [10, 4];
				}
			}
			container claims_min
			{
				attribute<uint32> Living (regMaps/p1) := uint32(claim_sources/p1/Living_min);
				attribute<uint32> Working(regMaps/p2) := uint32(claim_sources/p2/Working_min);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_min);
			}
			container aggr_claims_min
			{
				parameter<uint32> Living := sum(claims_min/Living);
				parameter<uint32> Working:= sum(claims_min/Working);
				parameter<uint32> Nature := sum(claims_min/Nature);
			}
			container claims_max
			{
				attribute<uint32> Living (regMaps/p1) := uint32(claim_sources/p1/Living_max);
				attribute<uint32> Working(regMaps/p2) := uint32(claim_sources/p2/Working_max);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_max);
			}
			container claims_max2
			{
				attribute<uint32> Living (regMaps/p1) := claims_max/Living + claims_max/Living;
				attribute<uint32> Nature (regMaps/p1) := claims_max/Nature + claims_max/Nature;
			}
			container aggr_claims_max
			{
				parameter<uint32> Living := sum(claims_max/Living);
				parameter<uint32> Working:= sum(claims_max/Working);
				parameter<uint32> Nature := sum(claims_max/Nature);
			}
			container regionSets
			{
				attribute<regMaps/p1> Nature (DomainGrid) := regMaps/p1Map;
				attribute<regMaps/p1> Living (DomainGrid) := regMaps/p1Map;
				attribute<regMaps/p2> Working(DomainGrid) := regMaps/p2Map;
			}
			unit<uint16> AtomicRegions := overlay(lu_type/PartioningName, DomainGrid, regionSets);

			attribute<bool> InRegio (DomainGrid):
			[
			 true, true, true,true,false,true,
			 true, true, true,true,false,true,
			 true, true, true,true,true,true,
			 true, true, true,true,true,true,
			 true, true, true,true,false,true,
			 true, true, true,true,true,true
			];
			attribute<bool> FreeLand (DomainGrid) := InRegio;

			container Compacted
			{
				unit <uint32>      ADomain := select_with_org_rel(FreeLand = true),
					label = "allocation domain";
				attribute<ADomain> BaseGrid (DomainGrid) :=invert(ADomain/org_rel);
				
				container SuitabilityMaps
				{
					attribute<int32> Living  (ADomain) := int32(Allocation/source/SuitabilityMaps/Living)[ADomain/org_rel]  * int32(1000);
					attribute<int32> Working (ADomain) := int32(Allocation/source/SuitabilityMaps/Working)[ADomain/org_rel] * int32(1000);
					attribute<int32> Nature  (ADomain) := int32(Allocation/source/SuitabilityMaps/Nature)[ADomain/org_rel]  * int32(1000);
				}
				container SuitabilityMapsDiv
				{
					attribute<int32> Living  (ADomain) := int32(Allocation/source/SuitabilityMaps/Living  * float32(1000) / float32(12.46220836))[ADomain/org_rel];
					attribute<int32> Working (ADomain) := int32(Allocation/source/SuitabilityMaps/Working * float32(1000) / float32(12.46220836))[ADomain/org_rel];
					attribute<int32> Nature  (ADomain) := int32(Allocation/source/SuitabilityMaps/Nature  * float32(1000) / float32(12.46220836))[ADomain/org_rel];
				}
				attribute<AtomicRegions> AtomicRegionMap(ADomain) := AtomicRegions/UnionData[ADomain/org_rel];
			}
			parameter<int32> treshold := int32(0);
			container FeasibleSolution;

			// p1-claims voor de _sp-varianten: alleen de geclaimde typen (Living, Nature),
			// beide over regio-eenheid p1. De volledige claims_min/claims_max bevatten ook
			// Working over p2 en horen bij de 11-argument multi-partitie-vorm.
			// De _sp-haalbaarheidstoets eist som(max-claims) >= #cellen (33), dus de
			// Living-max is hier 13 i.p.v. de 9 uit claim_sources (13 + 20 = 33).
			container claims_min_p1
			{
				attribute<uint32> Living (regMaps/p1) := uint32(claim_sources/p1/Living_min);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_min);
			}
			container claims_max_p1
			{
				attribute<uint32> Living (regMaps/p1) := const(13, regMaps/p1);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_max);
			}
		}
		// uint16-spiegel van de typenset: de *_16-operatorvarianten verwachten een
		// landgebruiktypen-domein met een uint16-waardetype i.p.v. uint8. De
		// partitioneringsrelatie zelf blijft uint8 (signatuurvereiste van de engine),
		// dus die krijgt een eigen uint8-domein.
		container source16
		{
			unit <uint16> lu_type: nrofrows = 3
			{
				attribute<string>        Name: [ 'Living', 'Working', 'Nature' ], DialogType = "LabelText";
				attribute<partition_set> partioning := convert(id(lu_type), partition_set);
			}
			unit<uint8> partition_set: nrofrows = 3
			{
				attribute<string> PartioningName: [ 'Living', 'Working', 'Nature' ];
			}
			unit<uint16> AtomicRegions := overlay(partition_set/PartioningName, DomainGrid, source/regionSets);
			attribute<AtomicRegions> AtomicRegionMap (source/Compacted/ADomain) :=
				AtomicRegions/UnionData[source/Compacted/ADomain/org_rel];
			unit<uint16> p1_claimed_type := select_uint16_with_attr_by_cond(lu_type, ID(lu_type) != 1w);
		}
		container Esource
		{
			unit<float32> EurM2;

			attribute<lu_type> landuse (EDomainGrid):
			[
			];
			unit <uint8> lu_type: nrofrows = 0
			{
				attribute<string>  Name:           [], DialogType = "LabelText";
				attribute<string>  PartioningName: [];
				attribute<lu_type> partioning := id(lu_type);
				attribute<uint32>  BrushColor: [], DialogType = "BrushColor";
			}
			container SuitabilityMaps
			{
				attribute<EurM2> Living  (DomainGrid):
				[
				];
				attribute<EurM2> Working (DomainGrid):
				[
				];
				attribute<EurM2> Nature  (DomainGrid):
				[
				];
			}
			container regMaps
			{
				unit <uint8> p1: nrofrows = 0;
				unit <uint8> p2: nrofrows = 0;

				attribute<p1> p1Map (DomainGrid) := const(0, DomainGrid, p1);
				attribute<p2> p2Map (DomainGrid) := pointRow(ID(DomainGrid)) < int16(4) ? value(0,p2) : value(1,p2);
			}
			container claim_sources
			{
				unit<float32> Meter := BaseUnit('m', float32);
				unit<float32> Ha :=10000.0 * Meter * Meter;

				container p1
				{
					attribute<Ha> Nature_min (regMaps/p1): [];
					attribute<Ha> Nature_max (regMaps/p1): [];
					attribute<Ha> Living_min (regMaps/p1): [];
					attribute<Ha> Living_max (regMaps/p1): [];
				}
				container p2
				{
					attribute<Ha> Working_min (regMaps/p2): [];
					attribute<Ha> Working_max (regMaps/p2): [];
				}
			}
			parameter <float32> nrHaPerCel := value(1, claim_sources/Ha);
			container claims_min
			{
				attribute<uint32> Living (regMaps/p1) := uint32(claim_sources/p1/Living_min  / nrHaPerCel);
				attribute<uint32> Working(regMaps/p2) := uint32(claim_sources/p2/Working_min / nrHaPerCel);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_min  / nrHaPerCel);
			}
			container claims_max
			{
				attribute<uint32> Living (regMaps/p1) := uint32(claim_sources/p1/Living_max  / nrHaPerCel);
				attribute<uint32> Working(regMaps/p2) := uint32(claim_sources/p2/Working_max / nrHaPerCel);
				attribute<uint32> Nature (regMaps/p1) := uint32(claim_sources/p1/Nature_max  / nrHaPerCel);
			}
			container regionSets
			{
				attribute<regMaps/p1> Nature (DomainGrid) := regMaps/p1Map;
				attribute<regMaps/p1> Living (DomainGrid) := regMaps/p1Map;
				attribute<regMaps/p2> Working(DomainGrid) := regMaps/p2Map;
			}
			unit<uint16> AtomicRegions := overlay(lu_type/PartioningName, DomainGrid, regionSets);

			attribute<bool> InRegio (DomainGrid):
			[
			];
			attribute<bool> FreeLand (DomainGrid) := InRegio;

			container Compacted
			{
				unit <uint32>      ADomain := select_with_org_rel(FreeLand = true),
					label = "allocation domain";
				attribute<ADomain> BaseGrid (DomainGrid) :=invert(ADomain/org_rel);
				
				container SuitabilityMaps
				{
					attribute<int32> Living  (ADomain) := int32(Allocation/source/SuitabilityMaps/Living)[ADomain/org_rel]  * int32(1000);
					attribute<int32> Working (ADomain) := int32(Allocation/source/SuitabilityMaps/Working)[ADomain/org_rel] * int32(1000);
					attribute<int32> Nature  (ADomain) := int32(Allocation/source/SuitabilityMaps/Nature)[ADomain/org_rel]  * int32(1000);
				}
				container SuitabilityMapsDiv
				{
					attribute<int32> Living  (ADomain) := int32(Allocation/source/SuitabilityMaps/Living  * float32(1000) / float32(12.46220836))[ADomain/org_rel];
					attribute<int32> Working (ADomain) := int32(Allocation/source/SuitabilityMaps/Working * float32(1000) / float32(12.46220836))[ADomain/org_rel];
					attribute<int32> Nature  (ADomain) := int32(Allocation/source/SuitabilityMaps/Nature  * float32(1000) / float32(12.46220836))[ADomain/org_rel];
				}
				attribute<AtomicRegions> AtomicRegionMap(ADomain) := AtomicRegions/UnionData[ADomain/org_rel];
			}
			parameter<int32> treshold := int32(0);
			container FeasibleSolution;
		}
		// greedy_alloc en needy_alloc: zelfde 11 argumenten als discrete_alloc, maar heuristisch
		// (eenmalige rangschikking van de landeenheden, geen schaduwprijzen, geen herallocatie).
		// Dus structurele checks i.p.v. een vaste verwachtingskaart:
		//   - statusFlag  : alle min/max claims gehaald
		//   - same_coverage: precies dezelfde eenheden toegewezen als discrete_alloc
		//   - total_realised <= dat van discrete_alloc, want die is optimaal
		// greedy rangschikt op hoogste geschiktheid, needy op spijt (beste min op een na beste).
		// GeoDMS issue 1171: t/m 20.10 liep greedy_alloc vast (spinnende retry na "Progress 0/33"),
		// op 20.11.0 faalde het met een interne check, en pas in 20.12.0 werd het een echt greedy
		// algoritme; de greedy-Spec-rijen zijn daarom afgegrensd met '>=20.12'.
		// needy_alloc bestaat pas vanaf 20.12.0 en heeft alleen de operatornaam als vereiste nodig.
		container greedy_alloc :=
			greedy_alloc(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/lu_type/partioning,
				source/lu_type/PartioningName,
				source/AtomicRegions,
				source/Compacted/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			// Cel 4 heeft voor alle typen een suitability onder de treshold en blijft dus
			// onverdeeld - net als bij allocate_discrete. Daarom een vergelijking van de
			// dekking i.p.v. all(IsDefined(landuse)).
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			// greedy/needy gebruiken geen schaduwprijzen, dus bid_price IS de gerealiseerde
			// geschiktheid van de toewijzing.
			parameter<int32> total_realised := sum(IsDefined(bid_price) ? bid_price : int32(0));
			parameter<bool>  test_attr :=
				   statusFlag
				&& all(same_coverage)
				&& total_realised <= allocate_discrete/total_realised;
		}
		container needy_alloc :=
			needy_alloc(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/lu_type/partioning,
				source/lu_type/PartioningName,
				source/AtomicRegions,
				source/Compacted/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<int32> total_realised := sum(IsDefined(bid_price) ? bid_price : int32(0));
			parameter<bool>  test_attr :=
				   statusFlag
				&& all(same_coverage)
				&& total_realised <= allocate_discrete/total_realised;
		}
		// *_16-varianten: identiek aan hun naamgenoten maar met een uint16-typenset
		// (source16/lu_type). Zelfde data, zelfde optimum: de toewijzing moet cel voor cel
		// overeenkomen met die van discrete_alloc (vergeleken via de typenummers).
		container allocate_discrete_16 :=
			discrete_alloc_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source16/lu_type/partioning,
				source16/partition_set/PartioningName,
				source16/AtomicRegions,
				source16/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			attribute<bool> same_alloc (source/Compacted/ADomain) :=
				eq_or_both_null(uint16(landuse), uint16(allocate_discrete/landuse));
			parameter<bool> test_attr := all(same_alloc);
		}
		container allocate_discrete_p1_16 :=
			discrete_alloc_sp_16(
				source16/p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<uint32> nrAllocated (source16/p1_claimed_type) := pcount(landuse);
			attribute<uint32> minClaim    (source16/p1_claimed_type) : [5, 12];
			attribute<uint32> maxClaim    (source16/p1_claimed_type) : [13, 20];
			attribute<bool>   claim_ok    (source16/p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>   test_attr := statusFlag && all(claim_ok);
		}
		container allocate_discrete_aggr_16 :=
			discrete_alloc_np_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<int32> realised (source/Compacted/ADomain) :=
				  !IsDefined(landuse)                   ? int32(0)
				: landuse == value(0, source16/lu_type) ? source/Compacted/SuitabilityMaps/Living
				: landuse == value(1, source16/lu_type) ? source/Compacted/SuitabilityMaps/Working
				:                                         source/Compacted/SuitabilityMaps/Nature;
			parameter<int32> total_realised := sum(realised);
			parameter<bool>  test_attr := statusFlag && total_realised >= allocate_discrete/total_realised;
		}
		// heuristische regimes over de variant-signaturen; zelfde structurele checks als bij
		// greedy_alloc/needy_alloc (geen vaste verwachtingskaart). De greedy-rijen zijn in de
		// Spec afgegrensd met '>=20.12' (GeoDMS issue 1171); needy bestaat pas vanaf 20.12.0
		// en filtert vanzelf op operatornaam.
		container greedy_alloc_16 :=
			greedy_alloc_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source16/lu_type/partioning,
				source16/partition_set/PartioningName,
				source16/AtomicRegions,
				source16/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<int32> total_realised := sum(IsDefined(bid_price) ? bid_price : int32(0));
			parameter<bool>  test_attr :=
				   statusFlag
				&& all(same_coverage)
				&& total_realised <= allocate_discrete/total_realised;
		}
		container greedy_alloc_sp :=
			greedy_alloc_sp(
				p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<uint32> nrAllocated (p1_claimed_type) := pcount(landuse);
			attribute<uint32> minClaim    (p1_claimed_type) : [5, 12];
			attribute<uint32> maxClaim    (p1_claimed_type) : [13, 20];
			attribute<bool>   claim_ok    (p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>   test_attr := statusFlag && all(claim_ok);
		}
		container greedy_alloc_sp_16 :=
			greedy_alloc_sp_16(
				source16/p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<uint32> nrAllocated (source16/p1_claimed_type) := pcount(landuse);
			attribute<uint32> minClaim    (source16/p1_claimed_type) : [5, 12];
			attribute<uint32> maxClaim    (source16/p1_claimed_type) : [13, 20];
			attribute<bool>   claim_ok    (source16/p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>   test_attr := statusFlag && all(claim_ok);
		}
		container greedy_alloc_np_16 :=
			greedy_alloc_np_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<bool> test_attr := statusFlag && all(same_coverage);
		}
		container needy_alloc_16 :=
			needy_alloc_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source16/lu_type/partioning,
				source16/partition_set/PartioningName,
				source16/AtomicRegions,
				source16/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<int32> total_realised := sum(IsDefined(bid_price) ? bid_price : int32(0));
			parameter<bool>  test_attr :=
				   statusFlag
				&& all(same_coverage)
				&& total_realised <= allocate_discrete/total_realised;
		}
		container needy_alloc_sp :=
			needy_alloc_sp(
				p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<uint32> nrAllocated (p1_claimed_type) := pcount(landuse);
			attribute<uint32> minClaim    (p1_claimed_type) : [5, 12];
			attribute<uint32> maxClaim    (p1_claimed_type) : [13, 20];
			attribute<bool>   claim_ok    (p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>   test_attr := statusFlag && all(claim_ok);
		}
		container needy_alloc_sp_16 :=
			needy_alloc_sp_16(
				source16/p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<uint32> nrAllocated (source16/p1_claimed_type) := pcount(landuse);
			attribute<uint32> minClaim    (source16/p1_claimed_type) : [5, 12];
			attribute<uint32> maxClaim    (source16/p1_claimed_type) : [13, 20];
			attribute<bool>   claim_ok    (source16/p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>   test_attr := statusFlag && all(claim_ok);
		}
		container needy_alloc_np_16 :=
			needy_alloc_np_16(
				source16/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<bool> test_attr := statusFlag && all(same_coverage);
		}
		// overlay64: als overlay maar met een uint64-resultaatdomein
		container overlay64
		{
			unit<uint64> AtomicRegions64 := overlay64(source/lu_type/PartioningName, DomainGrid, source/regionSets);
			parameter<bool> test_param := #AtomicRegions64 = uint64(#source/AtomicRegions);
		}
		container allocate_discrete :=
			discrete_alloc(
				source/lu_type/name, 
				source/Compacted/ADomain, 
				source/Compacted/SuitabilityMaps, 
				source/lu_type/partioning,
				source/lu_type/PartioningName,
				source/AtomicRegions,
				source/Compacted/AtomicRegionMap, 
				source/claims_min, 
				source/claims_max, 
				source/treshold, 
				source/FeasibleSolution
			)
		{
			attribute<Source/lu_type> att       (DomainGrid) := landuse[Source/Compacted/BaseGrid];
			attribute<bool>           test      (DomainGrid) := eq_or_both_null(att, Source/landuse);
			parameter<bool>           test_attr              := all(test);

			// Suitability actually realised by this allocation. discrete_alloc maximises it subject to
			// the claims, so it is the ceiling for the heuristic regimes (greedy_alloc, needy_alloc).
			// NB not sum(bid_price): for discrete_alloc bid_price has the shadow price added to it.
			attribute<int32> realised (source/Compacted/ADomain) :=
				  !IsDefined(landuse)                 ? int32(0)
				: landuse == value(0, source/lu_type) ? source/Compacted/SuitabilityMaps/Living
				: landuse == value(1, source/lu_type) ? source/Compacted/SuitabilityMaps/Working
				:                                       source/Compacted/SuitabilityMaps/Nature;
			parameter<int32> total_realised := sum(realised);
		}
		// _sp-varianten (8 argumenten): een partitionering voor alle typen, hier p1 (een regio)
		// met alleen de typen Living en Nature geclaimd. Er is geen referentiekaart voor deze
		// deelproblemen; getest wordt dat de engine de oplossing haalbaar meldt (statusFlag)
		// en dat de toewijzingsaantallen per type binnen de min/max-claims liggen
		// (waarden uit source/claim_sources/p1).
		unit<uint8> p1_claimed_type := select_uint8_with_attr_by_cond(source/lu_type, ID(source/lu_type) != 1b);
		container allocate_discrete_p1 :=
			discrete_alloc_sp(
				p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max_p1,
				source/treshold
			)
		{
			attribute<p1_claimed_type> att         (DomainGrid) := landuse[Source/Compacted/BaseGrid];
			attribute<uint32>          nrAllocated (p1_claimed_type) := pcount(landuse);
			attribute<uint32>          minClaim    (p1_claimed_type) : [5, 12];
			attribute<uint32>          maxClaim    (p1_claimed_type) : [13, 20];
			attribute<bool>            claim_ok    (p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>            test_attr := statusFlag && all(claim_ok);
		}
		// als allocate_discrete_p1 maar met verdubbelde max-claims (claims_max2): de
		// bovengrenzen knellen dan niet meer, alleen de ondergrenzen.
		container allocate_discrete_p2 :=
			discrete_alloc_sp(
				p1_claimed_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/regMaps/p1,
				source/regMaps/p1Map[source/compacted/ADomain/org_rel],
				source/claims_min_p1,
				source/claims_max2,
				source/treshold
			)
		{
			attribute<p1_claimed_type> att         (DomainGrid) := landuse[Source/Compacted/BaseGrid];
			attribute<uint32>          nrAllocated (p1_claimed_type) := pcount(landuse);
			attribute<uint32>          minClaim    (p1_claimed_type) : [5, 12];
			attribute<uint32>          maxClaim    (p1_claimed_type) : [18, 40];
			attribute<bool>            claim_ok    (p1_claimed_type) := nrAllocated >= minClaim && nrAllocated <= maxClaim;
			parameter<bool>            test_attr := statusFlag && all(claim_ok);
		}
		// _np-variant (6 argumenten): geen partitionering, claims als parameters (aggregaat).
		// Het aggregaat-probleem is een relaxatie van het volledige (Working mag vrij over
		// de twee p2-regio's verdeeld worden), dus het optimum is >= dat van discrete_alloc.
		container allocate_discrete_aggr :=
			discrete_alloc_np(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<Source/lu_type> att       (DomainGrid) := landuse[Source/Compacted/BaseGrid];
			attribute<int32> realised (source/Compacted/ADomain) :=
				  !IsDefined(landuse)                 ? int32(0)
				: landuse == value(0, source/lu_type) ? source/Compacted/SuitabilityMaps/Living
				: landuse == value(1, source/lu_type) ? source/Compacted/SuitabilityMaps/Working
				:                                       source/Compacted/SuitabilityMaps/Nature;
			parameter<int32> total_realised := sum(realised);
			parameter<bool>  test_attr := statusFlag && total_realised >= allocate_discrete/total_realised;
		}
		// dekking van de _np-variant (AR = Void) van de heuristische regimes; zelfde argumenten
		// als allocate_discrete_aggr
		container greedy_alloc_aggr :=
			greedy_alloc_np(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<bool> test_attr := statusFlag && all(same_coverage);
		}
		container needy_alloc_aggr :=
			needy_alloc_np(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMaps,
				source/aggr_claims_min,
				source/aggr_claims_max,
				source/treshold
			)
		{
			attribute<bool> same_coverage (source/Compacted/ADomain) :=
				IsDefined(landuse) == IsDefined(allocate_discrete/landuse);
			parameter<bool> test_attr := statusFlag && all(same_coverage);
		}
		container allocate_discrete_empty :=
			discrete_alloc(
				Esource/lu_type/name, 
				Esource/Compacted/ADomain, 
				Esource/Compacted/SuitabilityMaps, 
				Esource/lu_type/partioning,
				Esource/lu_type/PartioningName,
				Esource/AtomicRegions,
				Esource/Compacted/AtomicRegionMap, 
				Esource/claims_min, 
				Esource/claims_max, 
				Esource/treshold, 
				Esource/FeasibleSolution
			)
		{
			parameter<bool> test := trim(lowercase(status)) == 'no suitability maps';
		}
		container allocate_discrete_div_constant :=
			discrete_alloc(
				source/lu_type/name,
				source/Compacted/ADomain,
				source/Compacted/SuitabilityMapsDiv,
				source/lu_type/partioning,
				source/lu_type/PartioningName,
				source/AtomicRegions,
				source/Compacted/AtomicRegionMap,
				source/claims_min,
				source/claims_max,
				source/treshold,
				source/FeasibleSolution
			)
		{
			attribute<Source/lu_type> att       (DomainGrid) := landuse[Source/Compacted/BaseGrid];
			attribute<bool>           test      (DomainGrid) := eq_or_both_null(att, Source/landuse);
			parameter<bool>           test_attr              := all(test);
		}
	}

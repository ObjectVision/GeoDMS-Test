					,	'overlay_polygon/cgal_intersect2/test'
					];
				}
				container selection := TestSet(Cand, Cand/Spec);
				parameter<bool>   tests        := =selection/test_expr;
				parameter<uint32> nrExecuted   := =selection/count_expr;
				parameter<uint32> nrConfigured := =selection/conf_expr;
				parameter<string> failing      := =selection/fail_expr;
				parameter<string> skipped      := =selection/skip_expr;
			}
		}
	}

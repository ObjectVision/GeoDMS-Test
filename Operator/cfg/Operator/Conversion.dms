			container rgb: url = "http://www.objectvision.nl/geodms/operators-a-functions/conversion/rgb"
			{
				parameter<uint8>  red        := uint8(128);
				parameter<uint8>  green      := uint8(64);
				parameter<uint8>  blue       := uint8(192);
				parameter<uint32> param      := rgb(red,green,blue), DialogType = "Palette";
				parameter<bool>   test_param := param = 12599424;
			}
			container AsHex: url  = "http://www.objectvision.nl/geodms/operators-a-functions/conversion/ashex"
			{
				parameter<string> param         := AsHex(255);
				parameter<bool>   test_param    := param == '000000FF';
				attribute<string> att  (Domain) := AsHex(Source/IntegerAttHex);
				attribute<bool>   test (Domain) := att = Source/AsHex;
				parameter<bool>   test_attr     := all(test);
			}
			container UrlEncode: url = "http://www.objectvision.nl/geodms/operators-a-functions/string/urlencode"
			{
				parameter<string> param         := UrlEncode('<>&abcdef +%');
				parameter<bool>   test_param    := param == '%3C%3E%26abcdef+%2B%25';
				attribute<string> att  (Domain) := UrlEncode(Source/UrlEncodeDecode);
				attribute<bool>   test (Domain) := att = Source/UrlEncodeOk;
				parameter<bool>   test_attr     := all(test);
			}
			container UrlDecode: url = "http://www.objectvision.nl/geodms/operators-a-functions/string/urldecode"
			{
				// UrlDecode is the exact inverse of UrlEncode: '+' decodes to a space and non-ASCII
				// bytes survive the round trip ('%C3%A9' is e-acute in UTF-8, so 2 bytes).
				parameter<string> param         := UrlDecode('%3C%3E%26abcdef+%2B%25');
				parameter<bool>   test_param    := param == '<>&abcdef +%'
					&& UrlEncode(UrlDecode('%C3%A9')) == '%C3%A9'
					&& strlen(UrlDecode('%C3%A9')) == 2;
				attribute<string> att  (Domain) := UrlDecode(Source/UrlEncodeOk);
				attribute<bool>   test (Domain) := att = Source/UrlEncodeDecode;
				parameter<bool>   test_attr     := all(test);
			}
			container HtmlEncode: url = "http://www.objectvision.nl/geodms/operators-a-functions/string/htmlencode"
			{
				// the five predefined XML/HTML entities; anything else (incl. bytes >= 0x80) is left alone
				parameter<string> param         := HtmlEncode('<>&' + dquote('q') + quote('a'));
				parameter<bool>   test_param    := param == '&lt;&gt;&amp;&quot;q&quot;&apos;a&apos;';
				attribute<string> att  (Domain) := HtmlEncode(Source/HTMLEncodeDecode);
				attribute<bool>   test (Domain) := att = Source/HTMLEncodeOk;
				parameter<bool>   test_attr     := all(test);
			}
			container HtmlDecode: url = "http://www.objectvision.nl/geodms/operators-a-functions/string/htmldecode"
			{
				// inverse of HtmlEncode, plus numeric character references; an unknown entity is
				// copied through verbatim rather than being an error.
				parameter<string> param         := HtmlDecode('&lt;&gt;&amp;&quot;q&quot;&apos;a&apos;');
				parameter<bool>   test_param    := param == '<>&' + dquote('q') + quote('a')
					&& HtmlDecode('&#65;&#x42;') == 'AB'
					&& HtmlDecode('&unknown;')  == '&unknown;'
					&& HtmlDecode('&amp;lt;')   == '&lt;';
				attribute<string> att  (Domain) := HtmlDecode(Source/HTMLEncodeOk);
				attribute<bool>   test (Domain) := att = Source/HTMLEncodeDecode;
				parameter<bool>   test_attr     := all(test);
			}

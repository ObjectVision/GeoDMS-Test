	container Utf8Characters: Using = "/Domains;/Units;/Tolerances"
	{
		unit<float32>      €      := baseUnit('€', float32);
		unit<float32>      euro   := baseUnit('€', float32);
		unit<float32>      °      := baseUnit('°', float32);
		unit<float32>      graadC := baseUnit('°', float32);
		unit<float32>      Ω      := baseUnit('Ω', float32);

		parameter<float32> bezineprijs1 := 2[€];
		parameter<float32> bezineprijs2 := 2[euro];

		parameter<°>      kookpunt_water1 := 100[°];
		parameter<graadC> kookpunt_water2 := 100[graadC];

		parameter<float32> ß := 1f;
		parameter<float64> π := pi();
		parameter<float64> δ := 10d;
		parameter<float64> Δ := 10d;
		parameter<string>  â := 'δ';
		parameter<string>  @ := 'copyright';
		
		parameter<bool> tests := bezineprijs1 == bezineprijs2 && kookpunt_water1 == kookpunt_water2 && ß == 1f  && π == pi() && δ == 10d && Δ == 10d && â == 'δ' && @ == 'copyright';
	}

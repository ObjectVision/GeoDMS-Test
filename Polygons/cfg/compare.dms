////////////////////////////////////////////////////////////////////////////////
// Vergelijking van de vier geometrie-families (geos / bg / bp / cgal) op
// synthetische, deterministische data - draait zonder SourceData.
//
// Twee scenario's (issue 775/767/882/903-lijn):
//   ManySmall: veel kleine polygonen (rooster met jitter, partities)
//   FewLarge:  weinig grote polygonen (veelhoeken met veel punten, overlap)
// Per familie een eigen results-item zodat full.py ze als aparte experimenten
// draait en het rapport de rekentijden per familie naast elkaar zet.
//
// Correctheid per familie:
//   - invarianten: A(union) <= som(A); som(A(split_union-delen)) = A(union);
//     A(intersect)+A(xor) = A(union); idempotentie union(union)=union
//   - referentie: |A(union_f) - A(union_geos)| / A(union_geos) (geos = referentie;
//     geos is de aanbevolen default, zie wiki Geometric functions)
// bp werkt op integers: coordinaten x1000 (mm-schaal), oppervlaktes /1e6.
////////////////////////////////////////////////////////////////////////////////
container PolygonCompare
{
	container Parameters
	{
		parameter<uint32>  nrSmallCols := 64;   // ManySmall: nrSmallCols^2 polygonen
		parameter<uint32>  nrLarge     := 16;   // FewLarge: aantal grote polygonen
		parameter<uint32>  nrLargePnts := 256;  // punten per grote polygoon
		parameter<float64> relTol      := 1e-6; // tolerantie voor invarianten (float64-families)
		parameter<float64> relTolInt   := 1e-3; // tolerantie bp (mm-afronding)
	}

	unit<dpoint> crd_base;
	unit<float64> m2u := baseunit('pc_m2', float64);

	container ManySmall
	{
		unit<uint32> Cols := range(uint32, 0, Parameters/nrSmallCols);
		unit<uint32> Cells := range(uint32, 0, Parameters/nrSmallCols * Parameters/nrSmallCols)
		{
			attribute<float64> cx := float64(mod(id(.), Parameters/nrSmallCols)) * 10.0;
			attribute<float64> cy := float64(id(.) / Parameters/nrSmallCols) * 10.0;
			// deterministische jitter (rnd_uniform met vaste seed) en variabele maat
			attribute<float64> jx := rnd_uniform(1, ., range(float64, 0.0, 3.0));
			attribute<float64> jy := rnd_uniform(2, ., range(float64, 0.0, 3.0));
			attribute<float64> sz := rnd_uniform(3, ., range(float64, 3.0, 7.0));
			// 10 partities
			attribute<Parts>   part_rel := value(mod(id(.), 10), Parts);
		}
		unit<uint32> Parts := range(uint32, 0, 10);
		unit<uint32> CellPnts := range(uint32, 0, 5 * Parameters/nrSmallCols * Parameters/nrSmallCols)
		{
			attribute<Cells>   seq := value(id(.) / 5, Cells);
			attribute<uint32>  ord := mod(id(.), 5);
			// kloksgewijs vierkant met positieve oppervlakte:
			// (x,y)-offsets per ord: (0,0) (0,s) (s,s) (s,0) (0,0)
			attribute<float64> px := Cells/cx[seq] + Cells/jx[seq] + (ord = 2 || ord = 3 ? Cells/sz[seq] : 0.0);
			attribute<float64> py := Cells/cy[seq] + Cells/jy[seq] + (ord = 1 || ord = 2 ? Cells/sz[seq] : 0.0);
			attribute<dpoint>  pt   := point_yx(py, px, crd_base);
			attribute<ipoint>  pt_i := ipoint(point_yx(py * 1000.0, px * 1000.0, crd_base));
		}
		attribute<dpoint> geometry   (Cells, polygon) := points2polygon(CellPnts/pt, CellPnts/seq, CellPnts/ord);
		attribute<ipoint> geometry_i (Cells, polygon) := points2polygon(CellPnts/pt_i, CellPnts/seq, CellPnts/ord);
		parameter<float64> sumA := sum(area(geometry, m2u));
	}

	container FewLarge
	{
		unit<uint32> Polys := range(uint32, 0, Parameters/nrLarge)
		{
			attribute<float64> cx := float64(mod(id(.), 4)) * 150.0 + 100.0;
			attribute<float64> cy := float64(id(.) / 4) * 150.0 + 100.0;
			attribute<float64> r  := 80.0 + rnd_uniform(4, ., range(float64, 0.0, 40.0));
			attribute<Parts>   part_rel := value(mod(id(.), 4), Parts);
		}
		unit<uint32> Parts := range(uint32, 0, 4);
		unit<uint32> PolyPnts := range(uint32, 0, (Parameters/nrLargePnts + 1) * Parameters/nrLarge)
		{
			attribute<Polys>   seq := value(id(.) / (Parameters/nrLargePnts + 1), Polys);
			attribute<uint32>  ord := mod(id(.), Parameters/nrLargePnts + 1);
			// kloksgewijze veelhoek (hoek negatief door y-daling), licht gerimpelde straal
			attribute<float64> ang := float64(mod(ord, Parameters/nrLargePnts)) * (-6.283185307179586 / float64(Parameters/nrLargePnts));
			attribute<float64> rr  := Polys/r[seq] * (1.0 + 0.1 * cos(ang * 8.0));
			attribute<float64> px  := Polys/cx[seq] + rr * cos(ang);
			attribute<float64> py  := Polys/cy[seq] + rr * sin(ang);
			attribute<dpoint>  pt   := point_yx(py, px, crd_base);
			attribute<ipoint>  pt_i := ipoint(point_yx(py * 1000.0, px * 1000.0, crd_base));
		}
		attribute<dpoint> geometry   (Polys, polygon) := points2polygon(PolyPnts/pt, PolyPnts/seq, PolyPnts/ord);
		attribute<ipoint> geometry_i (Polys, polygon) := points2polygon(PolyPnts/pt_i, PolyPnts/seq, PolyPnts/ord);
		parameter<float64> sumA := sum(area(geometry, m2u));
	}

	// ---- Echte data (issues 903/775/767/882): gemeenten (weinig groot, provincie-
	// partities) en BAG-panden Amsterdam (veel klein, tegelpartities), plus de
	// zelfstandige issue-882-repro (twee aangrenzende grote polygonen waar de
	// infix-union faalde). Draait alleen waar de databronnen staan; full.py voegt
	// het t020_polygons_real-experiment alleen toe als de datamap bestaat.
	container ConfigSettings
	{
		container Overridable
		{
			// bewust een eigen naam (geen RSo_DataDir): full.py zet globaal
			// GEODMS_Overridable_RSo_DataDir voor andere projecten, en dat pad
			// wijkt per machine af van deze bron
			parameter<string> PolyDataDir := 'E:/SourceData/RuimteScanner/SD/RSOpen';
		}
	}
	container RealData
	{
		unit<dpoint> rd    := range(dpoint, point_yx(300000.0, 0.0), point_yx(625000.0, 280000.0));
		unit<ipoint> rd_mm := gridset(rd, point_xy(0.001, 0.001), point_xy(0.0, 0.0), ipoint);
		// bp kan landsdekkende data niet in mm aan (25-bits coordinaatlimiet na
		// centrering: +-77M mm > 33.5M), dus de gemeenten krijgen cm-schaal
		unit<ipoint> rd_cm := gridset(rd, point_xy(0.01, 0.01), point_xy(0.0, 0.0), ipoint);

		container Bron
		:	StorageName     = "%PolyDataDir%/RegioIndelingen/cbsgebiedsindelingen2022.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	SyncMode        = "alltables"
		,	DialogData      = "/RealData/rd";

		container Gemeenten
		{
			unit<uint32> Parts := Bron/provincie_gegeneraliseerd
			{
				attribute<rd> geometry (poly) := Bron/provincie_gegeneraliseerd/geometry;
			}
			unit<uint32> Elems := Bron/gemeente_niet_gegeneraliseerd;
			attribute<rd>     geometry   (Elems, polygon) := Bron/gemeente_niet_gegeneraliseerd/geometry;
			attribute<ipoint> geometry_i (Elems, polygon) := geometry[rd_cm];
			// mid-in-provincie; MakeDefined vangt een eventuele mid-buiten-alles af
			// (zou anders elementen uit de partitie-union laten vallen)
			attribute<Parts>  part_rel   (Elems) :=
				MakeDefined(point_in_polygon(centroid_or_mid(geometry), Parts/geometry), value(0, Parts));
			parameter<float64> sumA := sum(area(geometry, m2u));
		}
		container PandenAms
		{
			// Amsterdam-bbox in RD-millimeters: x 110000..135000 m, y 476000..494000 m
			unit<uint32> pand_all
			:	StorageName     = "%PolyDataDir%/Vastgoed/VolledigeTabel_20240708/pand.fss"
			,	StorageReadOnly = "True"
			{
				attribute<rd_mm> geometry_mm (poly);
				attribute<rd_mm> fp    := first_point(geometry_mm);
				attribute<bool>  inAms :=
					   PointCol(fp) >= int32(110000000) && PointCol(fp) < int32(135000000)
					&& PointRow(fp) >= int32(476000000) && PointRow(fp) < int32(494000000);
			}
			unit<uint32> Elems := select_with_org_rel(pand_all/inAms);
			attribute<rd>     geometry   (Elems, polygon) := pand_all/geometry_mm[Elems/org_rel][rd];
			attribute<ipoint> geometry_i (Elems, polygon) := pand_all/geometry_mm[Elems/org_rel];
			// 4x4 tegels over de bbox als partitionering
			unit<uint32> Parts := range(uint32, 0, 16);
			attribute<rd_mm>  fp_sel (Elems) := pand_all/fp[Elems/org_rel];
			attribute<uint32> tx     (Elems) := min_elem(uint32(3), uint32((PointCol(fp_sel) - int32(110000000)) / int32(6250000)));
			attribute<uint32> ty     (Elems) := min_elem(uint32(3), uint32((PointRow(fp_sel) - int32(476000000)) / int32(4500000)));
			attribute<Parts>  part_rel (Elems) := value(ty * uint32(4) + tx, Parts);
			parameter<float64> sumA := sum(area(geometry, m2u));
		}
	}
	#include <../../main/issue_882.dms>

	container Ops
	{
		Template Scenario_T
		{
			// begin case parameters
			unit<uint32> Elems;
			unit<uint32> Parts;
			attribute<dpoint> geometry (Elems, polygon);
			attribute<ipoint> geometry_i (Elems, polygon);
			attribute<Parts>  part_rel (Elems);
			parameter<float64> sumA;
			parameter<float64> relTolF;
			// kwadraat van de integer-schaalfactor van geometry_i (1e6 voor mm, 1e4
			// voor cm); bp heeft een 25-bits coordinaatlimiet, dus landsdekkende data
			// past niet in mm en krijgt een grovere schaal
			parameter<float64> intAreaDiv;
			// end case parameters

			container geos
			{
				attribute<dpoint> u_part (Parts, polygon) := geos_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := geos_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := geos_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := geos_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				parameter<bool> ok :=
					   uA <= sumA * (1.0 + relTolF)
					&& abs(uiA - utA) <= utA * relTolF
					&& suN > uint32(0) && suN <= #Elems;
			}
			container bg
			{
				attribute<dpoint> u_part (Parts, polygon) := bg_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := bg_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := bg_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := bg_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok :=
					   uA <= sumA * (1.0 + relTolF)
					&& abs(uiA - utA) <= utA * relTolF
					&& suN > uint32(0) && suN <= #Elems
					&& devVsGeos <= relTolF * 100.0;
			}
			container bp
			{
				attribute<ipoint> u_part (Parts, polygon) := bp_union_polygon(geometry_i, part_rel);
				parameter<float64> uA := sum(area(dpolygon(u_part), m2u)) / intAreaDiv;
				parameter<ipoint> u_tot (polygon) := bp_union_polygon(geometry_i);
				parameter<ipoint> u_tot2 (polygon) := bp_union_polygon(u_part);
				parameter<float64> uiA  := area(dpolygon(u_tot2), m2u) / intAreaDiv;
				parameter<float64> utA  := area(dpolygon(u_tot), m2u) / intAreaDiv;
				unit<uint32> su := bp_split_union_polygon(geometry_i);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok :=
					   uA <= sumA * (1.0 + relTolF + 1e-3)
					&& abs(uiA - utA) <= utA * (relTolF + 1e-3)
					&& suN > uint32(0) && suN <= #Elems
					&& devVsGeos <= 1e-2;
			}
			container cgal
			{
				attribute<dpoint> u_part (Parts, polygon) := cgal_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := cgal_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := cgal_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := cgal_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok :=
					   uA <= sumA * (1.0 + relTolF)
					&& abs(uiA - utA) <= utA * relTolF
					&& suN > uint32(0) && suN <= #Elems
					&& devVsGeos <= relTolF * 100.0;
			}
		}

		container ManySmall := Scenario_T(../ManySmall/Cells, ../ManySmall/Parts, ../ManySmall/geometry, ../ManySmall/geometry_i, ../ManySmall/Cells/part_rel, ../ManySmall/sumA, Parameters/relTol, 1e6);
		container FewLarge  := Scenario_T(../FewLarge/Polys, ../FewLarge/Parts, ../FewLarge/geometry, ../FewLarge/geometry_i, ../FewLarge/Polys/part_rel, ../FewLarge/sumA, Parameters/relTol, 1e6);

		// echte-datascenario's (alleen berekend via results/real); gemeenten in cm
		container GemReal    := Scenario_T(../RealData/Gemeenten/Elems, ../RealData/Gemeenten/Parts, ../RealData/Gemeenten/geometry, ../RealData/Gemeenten/geometry_i, ../RealData/Gemeenten/part_rel, ../RealData/Gemeenten/sumA, Parameters/relTol, 1e4);
		container PandenReal := Scenario_T(../RealData/PandenAms/Elems, ../RealData/PandenAms/Parts, ../RealData/PandenAms/geometry, ../RealData/PandenAms/geometry_i, ../RealData/PandenAms/part_rel, ../RealData/PandenAms/sumA, Parameters/relTol, 1e6);
	}

	// Een gezamenlijke uitslag voor de vier families: per familie een eigen tagregel
	// (status, uniearealen en afwijking t.o.v. geos), een <failing>-regel met de
	// falende familie-scenario-combinaties, en een EN-oordeel over alles.
	container results
	{
		parameter<string> results_folder_filename := '%LocalDataDir%/Regression/log/results_folder.txt';
		parameter<string> results_folder : Storagename = "= results_folder_filename", StorageType = "str";

		Template FamLine_T
		{
			parameter<string> famName;
			parameter<bool>   okMS;
			parameter<bool>   okFL;
			parameter<float64> uaMS;
			parameter<float64> uaFL;
			parameter<float64> devMS;
			parameter<float64> devFL;
			//
			parameter<bool>   ok := okMS && okFL;
			parameter<string> line :=
				'<' + famName + '>' + (ok ? 'OK' : 'FAILS')
				+ '; union area ManySmall ' + string(float32(uaMS)) + ', FewLarge ' + string(float32(uaFL))
				+ (famName == 'geos' ? '' : '; dev vs geos ' + string(float32(devMS)) + ' / ' + string(float32(devFL)))
				+ '</' + famName + '>';
			parameter<string> failnote :=
				(okMS ? '' : famName + '-ManySmall; ') + (okFL ? '' : famName + '-FewLarge; ');
		}

		container geos := FamLine_T('geos', Ops/ManySmall/geos/ok, Ops/FewLarge/geos/ok, Ops/ManySmall/geos/uA, Ops/FewLarge/geos/uA, 0.0, 0.0);
		container bg   := FamLine_T('bg',   Ops/ManySmall/bg/ok,   Ops/FewLarge/bg/ok,   Ops/ManySmall/bg/uA,   Ops/FewLarge/bg/uA,   Ops/ManySmall/bg/devVsGeos,   Ops/FewLarge/bg/devVsGeos);
		container bp   := FamLine_T('bp',   Ops/ManySmall/bp/ok,   Ops/FewLarge/bp/ok,   Ops/ManySmall/bp/uA,   Ops/FewLarge/bp/uA,   Ops/ManySmall/bp/devVsGeos,   Ops/FewLarge/bp/devVsGeos);
		container cgal := FamLine_T('cgal', Ops/ManySmall/cgal/ok, Ops/FewLarge/cgal/ok, Ops/ManySmall/cgal/uA, Ops/FewLarge/cgal/uA, Ops/ManySmall/cgal/devVsGeos, Ops/FewLarge/cgal/devVsGeos);

		container all
		{
			parameter<bool>   allOk   := geos/ok && bg/ok && bp/ok && cgal/ok;
			parameter<string> failing := geos/failnote + bg/failnote + bp/failnote + cgal/failnote;
			parameter<string> result :=
				'<description>polygon family compare (geos/bg/bp/cgal, synthetic ManySmall + FewLarge)</description>'
				+ geos/line + bg/line + bp/line + cgal/line
				+ (failing == '' ? '' : '<failing>' + failing + '</failing>')
				+ '<result>' + (allOk ? 'OK' : 'False') + '</result>';
			parameter<string> stored_result := result, StorageType = "str", Storagename = "= results_folder + '/t020_polygons.txt'";
		}

		// ---- echte data: aparte indicator (t020_polygons_real.txt); zie RealData ----
		// per familie EEN regel over beide scenario's (gemeenten + panden), plus de
		// issue-882-repro: de infix-union (+) van twee aangrenzende grote polygonen
		// en van twee uitgeknipte secties, vergeleken met geos over dezelfde invoer.
		Template FamLine2_T
		{
			parameter<string> famName;
			parameter<bool>   okGem;
			parameter<bool>   okPand;
			parameter<float64> devGem;
			parameter<float64> devPand;
			//
			parameter<bool>   ok := okGem && okPand;
			parameter<string> line :=
				'<' + famName + '>' + (ok ? 'OK' : 'FAILS')
				+ (famName == 'geos' ? '' : '; dev vs geos Gemeenten ' + string(float32(devGem)) + ', PandenAms ' + string(float32(devPand)))
				+ '</' + famName + '>';
			parameter<string> failnote :=
				(okGem ? '' : famName + '-Gemeenten; ') + (okPand ? '' : famName + '-PandenAms; ');
		}
		container real
		{
			container geos := FamLine2_T('geos', Ops/GemReal/geos/ok, Ops/PandenReal/geos/ok, 0.0, 0.0);
			// bg op de BAG-panden crasht de hele engine (zelfintersecties, GEOS-fix
			// faalt; GeoDMS issue 1176) - tot de fix een expliciete SKIP-regel voor het
			// pandendeel, zodat de rest van de vergelijking een uitslag blijft geven
			container bg
			{
				parameter<bool>   ok := Ops/GemReal/bg/ok;
				parameter<string> line :=
					'<bg>' + (ok ? 'OK' : 'FAILS')
					+ ' (alleen Gemeenten; PandenAms overgeslagen: bg_union_polygon crasht, GeoDMS issue 1176)'
					+ '; dev vs geos Gemeenten ' + string(float32(Ops/GemReal/bg/devVsGeos)) + '</bg>';
				parameter<string> failnote := ok ? '' : 'bg-Gemeenten; ';
			}
			container bp   := FamLine2_T('bp',   Ops/GemReal/bp/ok,   Ops/PandenReal/bp/ok,   Ops/GemReal/bp/devVsGeos,   Ops/PandenReal/bp/devVsGeos);
			container cgal := FamLine2_T('cgal', Ops/GemReal/cgal/ok, Ops/PandenReal/cgal/ok, Ops/GemReal/cgal/devVsGeos, Ops/PandenReal/cgal/devVsGeos);

			container i882
			{
				unit<uint32> two: nrofrows = 2;
				attribute<dpoint> geoms (two, polygon) := union_data(two, /issue_882/p1/geo0, /issue_882/p2/geo0);
				attribute<dpoint> secs  (two, polygon) := union_data(two, /issue_882/s1, /issue_882/s2);
				parameter<float64> aU  := area(/issue_882/union_gone, m2u);
				parameter<float64> aG  := area(geos_union_polygon(geoms), m2u);
				parameter<float64> aS  := area(/issue_882/section_gone, m2u);
				parameter<float64> aSG := area(geos_union_polygon(secs), m2u);
				parameter<bool> ok_union   := abs(aU - aG)  <= aG  * 1e-6;
				parameter<bool> ok_section := abs(aS - aSG) <= aSG * 1e-6;
				parameter<string> line :=
					'<i882_union>'   + (ok_union   ? 'OK' : 'FAILS') + '; infix ' + string(float32(aU)) + ' vs geos ' + string(float32(aG))  + '</i882_union>'
					+ '<i882_section>' + (ok_section ? 'OK' : 'FAILS') + '; infix ' + string(float32(aS)) + ' vs geos ' + string(float32(aSG)) + '</i882_section>';
				parameter<string> failnote :=
					(ok_union ? '' : 'i882-union; ') + (ok_section ? '' : 'i882-section; ');
			}

			parameter<uint32> nrGem  := #/RealData/Gemeenten/Elems;
			parameter<uint32> nrPand := #/RealData/PandenAms/Elems;
			parameter<bool>   allOk   := geos/ok && bg/ok && bp/ok && cgal/ok && i882/ok_union && i882/ok_section;
			parameter<string> failing := geos/failnote + bg/failnote + bp/failnote + cgal/failnote + i882/failnote;
			parameter<string> result :=
				'<description>polygon family compare, real data (Gemeenten ' + string(nrGem) + 'x, BAG-panden Amsterdam ' + string(nrPand) + 'x, issue-882 repro)</description>'
				+ geos/line + bg/line + bp/line + cgal/line + i882/line
				+ (failing == '' ? '' : '<failing>' + failing + '</failing>')
				+ '<result>' + (allOk ? 'OK' : 'False') + '</result>';
			parameter<string> stored_result := result, StorageType = "str", Storagename = "= results_folder + '/t020_polygons_real.txt'";
		}
	}
}

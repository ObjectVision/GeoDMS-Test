////////////////////////////////////////////////////////////////////////////////
// Vergelijking van de vier geometrie-families (geos / bg / bp / cgal) op
// synthetische, deterministische data - draait zonder SourceData.
//
// Twee scenario's (issue 775/767/882/903-lijn):
//   ManySmall: veel kleine polygonen (rooster met jitter, partities)
//   FewLarge:  weinig grote polygonen (veelhoeken met veel punten, overlap)
// Per familie een eigen results-item zodat full.py ze als aparte experimenten
// draait en het rapport de rekentijden per familie naast elkaar zet.
//
// Correctheid per familie:
//   - invarianten: A(union) <= som(A); som(A(split_union-delen)) = A(union);
//     A(intersect)+A(xor) = A(union); idempotentie union(union)=union
//   - referentie: |A(union_f) - A(union_geos)| / A(union_geos) (geos = referentie;
//     geos is de aanbevolen default, zie wiki Geometric functions)
// bp werkt op integers: coordinaten x1000 (mm-schaal), oppervlaktes /1e6.
////////////////////////////////////////////////////////////////////////////////
container PolygonCompare
{
	container Parameters
	{
		parameter<uint32>  nrSmallCols := 64;   // ManySmall: nrSmallCols^2 polygonen
		parameter<uint32>  nrLarge     := 16;   // FewLarge: aantal grote polygonen
		parameter<uint32>  nrLargePnts := 256;  // punten per grote polygoon
		parameter<float64> relTol      := 1e-6; // tolerantie voor invarianten (float64-families)
		parameter<float64> relTolInt   := 1e-3; // tolerantie bp (mm-afronding)
	}

	unit<dpoint> crd_base;
	unit<float64> m2u := baseunit('pc_m2', float64);

	container ManySmall
	{
		unit<uint32> Cols := range(uint32, 0, Parameters/nrSmallCols);
		unit<uint32> Cells := range(uint32, 0, Parameters/nrSmallCols * Parameters/nrSmallCols)
		{
			attribute<float64> cx := float64(mod(id(.), Parameters/nrSmallCols)) * 10.0;
			attribute<float64> cy := float64(id(.) / Parameters/nrSmallCols) * 10.0;
			// deterministische jitter (rnd_uniform met vaste seed) en variabele maat
			attribute<float64> jx := rnd_uniform(1, ., range(float64, 0.0, 3.0));
			attribute<float64> jy := rnd_uniform(2, ., range(float64, 0.0, 3.0));
			attribute<float64> sz := rnd_uniform(3, ., range(float64, 3.0, 7.0));
			// 10 partities
			attribute<Parts>   part_rel := value(mod(id(.), 10), Parts);
		}
		unit<uint32> Parts := range(uint32, 0, 10);
		unit<uint32> CellPnts := range(uint32, 0, 5 * Parameters/nrSmallCols * Parameters/nrSmallCols)
		{
			attribute<Cells>   seq := value(id(.) / 5, Cells);
			attribute<uint32>  ord := mod(id(.), 5);
			// kloksgewijs vierkant met positieve oppervlakte:
			// (x,y)-offsets per ord: (0,0) (0,s) (s,s) (s,0) (0,0)
			attribute<float64> px := Cells/cx[seq] + Cells/jx[seq] + (ord = 2 || ord = 3 ? Cells/sz[seq] : 0.0);
			attribute<float64> py := Cells/cy[seq] + Cells/jy[seq] + (ord = 1 || ord = 2 ? Cells/sz[seq] : 0.0);
			attribute<dpoint>  pt   := point_yx(py, px, crd_base);
			attribute<ipoint>  pt_i := ipoint(point_yx(py * 1000.0, px * 1000.0, crd_base));
		}
		attribute<dpoint> geometry   (Cells, polygon) := points2polygon(CellPnts/pt, CellPnts/seq, CellPnts/ord);
		attribute<ipoint> geometry_i (Cells, polygon) := points2polygon(CellPnts/pt_i, CellPnts/seq, CellPnts/ord);
		parameter<float64> sumA := sum(area(geometry, m2u));
	}

	container FewLarge
	{
		unit<uint32> Polys := range(uint32, 0, Parameters/nrLarge)
		{
			attribute<float64> cx := float64(mod(id(.), 4)) * 150.0 + 100.0;
			attribute<float64> cy := float64(id(.) / 4) * 150.0 + 100.0;
			attribute<float64> r  := 80.0 + rnd_uniform(4, ., range(float64, 0.0, 40.0));
			attribute<Parts>   part_rel := value(mod(id(.), 4), Parts);
		}
		unit<uint32> Parts := range(uint32, 0, 4);
		unit<uint32> PolyPnts := range(uint32, 0, (Parameters/nrLargePnts + 1) * Parameters/nrLarge)
		{
			attribute<Polys>   seq := value(id(.) / (Parameters/nrLargePnts + 1), Polys);
			attribute<uint32>  ord := mod(id(.), Parameters/nrLargePnts + 1);
			// kloksgewijze veelhoek (hoek negatief door y-daling), licht gerimpelde straal
			attribute<float64> ang := float64(mod(ord, Parameters/nrLargePnts)) * (-6.283185307179586 / float64(Parameters/nrLargePnts));
			attribute<float64> rr  := Polys/r[seq] * (1.0 + 0.1 * cos(ang * 8.0));
			attribute<float64> px  := Polys/cx[seq] + rr * cos(ang);
			attribute<float64> py  := Polys/cy[seq] + rr * sin(ang);
			attribute<dpoint>  pt   := point_yx(py, px, crd_base);
			attribute<ipoint>  pt_i := ipoint(point_yx(py * 1000.0, px * 1000.0, crd_base));
		}
		attribute<dpoint> geometry   (Polys, polygon) := points2polygon(PolyPnts/pt, PolyPnts/seq, PolyPnts/ord);
		attribute<ipoint> geometry_i (Polys, polygon) := points2polygon(PolyPnts/pt_i, PolyPnts/seq, PolyPnts/ord);
		parameter<float64> sumA := sum(area(geometry, m2u));
	}

	// ---- Echte data (issues 903/775/767/882): gemeenten (weinig groot, provincie-
	// partities) en BAG-panden Amsterdam (veel klein, tegelpartities), plus de
	// zelfstandige issue-882-repro (twee aangrenzende grote polygonen waar de
	// infix-union faalde). Draait alleen waar de databronnen staan; full.py voegt
	// het t020_polygons_real-experiment alleen toe als de datamap bestaat.
	container ConfigSettings
	{
		container Overridable
		{
			// bewust een eigen naam (geen RSo_DataDir): full.py zet globaal
			// GEODMS_Overridable_RSo_DataDir voor andere projecten, en dat pad
			// wijkt per machine af van deze bron
			parameter<string> PolyDataDir := 'E:/SourceData/RuimteScanner/SD/RSOpen';
			// BAG-snapshotmap binnen PolyDataDir/Vastgoed; de datum verschilt per
			// machine (OVSRV08 _20240708, OVSRV05 _20250710), dus full.py zet
			// GEODMS_Overridable_PandSnapshot op de nieuwste map met een pand.fss.
			// Zonder deze parameter zou een puur machineverschil de test rood maken.
			parameter<string> PandSnapshot := 'VolledigeTabel_20240708';
		}
	}
	container RealData
	{
		unit<dpoint> rd    := range(dpoint, point_yx(300000.0, 0.0), point_yx(625000.0, 280000.0));
		unit<ipoint> rd_mm := gridset(rd, point_xy(0.001, 0.001), point_xy(0.0, 0.0), ipoint);
		// bp kan landsdekkende data niet in mm aan (25-bits coordinaatlimiet na
		// centrering: +-77M mm > 33.5M), dus de gemeenten krijgen cm-schaal
		unit<ipoint> rd_cm := gridset(rd, point_xy(0.01, 0.01), point_xy(0.0, 0.0), ipoint);

		container Bron
		:	StorageName     = "%PolyDataDir%/RegioIndelingen/cbsgebiedsindelingen2022.gpkg"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		,	SyncMode        = "alltables"
		,	DialogData      = "/RealData/rd";

		container Gemeenten
		{
			// bewust klein gehouden (beleid Jip: datafouten opsporen zonder lange
			// wachttijden): alleen de gemeenten van Noord-Holland (~44, incl. het
			// issue-882-gebied), verdeeld over 4 mod-partities - de partitie-union-
			// invariant houdt dan juist veel gedeelde grenzen over om op te breken
			container ProvAll
			{
				attribute<rd>     geometry (Bron/provincie_gegeneraliseerd, poly) := Bron/provincie_gegeneraliseerd/geometry;
				attribute<string> statnaam (Bron/provincie_gegeneraliseerd)       := Bron/provincie_gegeneraliseerd/statnaam;
				parameter<uint32> nh := rlookup('Noord-Holland', statnaam);
			}
			container GemAll
			{
				attribute<rd>       geometry (Bron/gemeente_niet_gegeneraliseerd, poly) := Bron/gemeente_niet_gegeneraliseerd/geometry;
				attribute<uint32>   prov (Bron/gemeente_niet_gegeneraliseerd) :=
					MakeDefined(uint32(point_in_polygon(centroid_or_mid(geometry), ProvAll/geometry)), uint32(9999));
			}
			unit<uint32> Elems := select_with_org_rel(GemAll/prov == ProvAll/nh);
			attribute<rd>     geometry   (Elems, polygon) := GemAll/geometry[Elems/org_rel];
			attribute<ipoint> geometry_i (Elems, polygon) := geometry[rd_cm];
			unit<uint32> Parts := range(uint32, 0, 4);
			attribute<Parts>  part_rel   (Elems) := value(mod(id(Elems), 4), Parts);
			parameter<float64> sumA := sum(area(geometry, m2u));
		}
		container PandenAms
		{
			// bbox binnenstad Amsterdam in RD-millimeters: x 118000..122000 m,
			// y 484000..488000 m (4x4 km, tienduizenden panden). Bewust klein
			// (beleid Jip: datafouten opsporen zonder lange wachttijden - cgal
			// rekent minuten op grotere selecties; op de volle gemeente stierven
			// de union-bewerkingen zelfs). Opschalen is een aparte vervolgstap.
			unit<uint32> pand_all
			:	StorageName     = "%PolyDataDir%/Vastgoed/%PandSnapshot%/pand.fss"
			,	StorageReadOnly = "True"
			{
				attribute<rd_mm> geometry_mm (poly);
				attribute<rd_mm> fp    := first_point(geometry_mm);
				attribute<bool>  inAms :=
					   PointCol(fp) >= int32(118000000) && PointCol(fp) < int32(122000000)
					&& PointRow(fp) >= int32(484000000) && PointRow(fp) < int32(488000000);
			}
			unit<uint32> Elems := select_with_org_rel(pand_all/inAms);
			attribute<rd>     geometry   (Elems, polygon) := pand_all/geometry_mm[Elems/org_rel][rd];
			attribute<ipoint> geometry_i (Elems, polygon) := pand_all/geometry_mm[Elems/org_rel];
			// 4x4 tegels over de bbox als partitionering
			unit<uint32> Parts := range(uint32, 0, 16);
			attribute<rd_mm>  fp_sel (Elems) := pand_all/fp[Elems/org_rel];
			attribute<uint32> tx     (Elems) := min_elem(uint32(3), uint32((PointCol(fp_sel) - int32(118000000)) / int32(1000000)));
			attribute<uint32> ty     (Elems) := min_elem(uint32(3), uint32((PointRow(fp_sel) - int32(484000000)) / int32(1000000)));
			attribute<Parts>  part_rel (Elems) := value(ty * uint32(4) + tx, Parts);
			parameter<float64> sumA := sum(area(geometry, m2u));
		}
	}
	#include <../../main/issue_882.dms>
	#include <../../../Regression/cfg/generic/TestResult.dms>
	#include <../../main/ring_encoding.dms>

	container Ops
	{
		Template Scenario_T
		{
			// begin case parameters
			unit<uint32> Elems;
			unit<uint32> Parts;
			attribute<dpoint> geometry (Elems, polygon);
			attribute<ipoint> geometry_i (Elems, polygon);
			attribute<Parts>  part_rel (Elems);
			parameter<float64> sumA;
			parameter<float64> relTolF;
			// kwadraat van de integer-schaalfactor van geometry_i (1e6 voor mm, 1e4
			// voor cm); bp heeft een 25-bits coordinaatlimiet, dus landsdekkende data
			// past niet in mm en krijgt een grovere schaal
			parameter<float64> intAreaDiv;
			// end case parameters

			container geos
			{
				attribute<dpoint> u_part (Parts, polygon) := geos_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := geos_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := geos_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := geos_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				// losse invarianten, zodat een FAILS kan benoemen wat er faalt
				parameter<bool> ok_area  := uA <= sumA * (1.0 + relTolF);
				parameter<bool> ok_idem  := abs(uiA - utA) <= utA * relTolF;
				parameter<bool> ok_split := suN > uint32(0) && suN <= #Elems;
				parameter<bool> ok := ok_area && ok_idem && ok_split;
				parameter<string> failwhat :=
					(ok_area ? '' : 'area-sum ') + (ok_idem ? '' : 'idempotence ') + (ok_split ? '' : 'split-count ');
			}
			container bg
			{
				attribute<dpoint> u_part (Parts, polygon) := bg_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := bg_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := bg_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := bg_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok_area  := uA <= sumA * (1.0 + relTolF);
				parameter<bool> ok_idem  := abs(uiA - utA) <= utA * relTolF;
				parameter<bool> ok_split := suN > uint32(0) && suN <= #Elems;
				parameter<bool> ok_dev   := devVsGeos <= relTolF * 100.0;
				parameter<bool> ok := ok_area && ok_idem && ok_split && ok_dev;
				parameter<string> failwhat :=
					(ok_area ? '' : 'area-sum ') + (ok_idem ? '' : 'idempotence ') + (ok_split ? '' : 'split-count ') + (ok_dev ? '' : 'area-vs-geos ');
			}
			container bp
			{
				attribute<ipoint> u_part (Parts, polygon) := bp_union_polygon(geometry_i, part_rel);
				parameter<float64> uA := sum(area(dpolygon(u_part), m2u)) / intAreaDiv;
				parameter<ipoint> u_tot (polygon) := bp_union_polygon(geometry_i);
				parameter<ipoint> u_tot2 (polygon) := bp_union_polygon(u_part);
				parameter<float64> uiA  := area(dpolygon(u_tot2), m2u) / intAreaDiv;
				parameter<float64> utA  := area(dpolygon(u_tot), m2u) / intAreaDiv;
				unit<uint32> su := bp_split_union_polygon(geometry_i);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok_area  := uA <= sumA * (1.0 + relTolF + 1e-3);
				parameter<bool> ok_idem  := abs(uiA - utA) <= utA * (relTolF + 1e-3);
				parameter<bool> ok_split := suN > uint32(0) && suN <= #Elems;
				parameter<bool> ok_dev   := devVsGeos <= 1e-2;
				parameter<bool> ok := ok_area && ok_idem && ok_split && ok_dev;
				parameter<string> failwhat :=
					(ok_area ? '' : 'area-sum ') + (ok_idem ? '' : 'idempotence ') + (ok_split ? '' : 'split-count ') + (ok_dev ? '' : 'area-vs-geos ');
			}
			container cgal
			{
				attribute<dpoint> u_part (Parts, polygon) := cgal_union_polygon(geometry, part_rel);
				parameter<float64> uA := sum(area(u_part, m2u));
				parameter<dpoint> u_tot (polygon) := cgal_union_polygon(geometry);
				parameter<dpoint> u_tot2 (polygon) := cgal_union_polygon(u_part);
				parameter<float64> uiA  := area(u_tot2, m2u);
				parameter<float64> utA  := area(u_tot, m2u);
				unit<uint32> su := cgal_split_union_polygon(geometry);
				parameter<uint32>  suN := #su;
				parameter<float64> devVsGeos := abs(uA - geos/uA) / geos/uA;
				parameter<bool> ok_area  := uA <= sumA * (1.0 + relTolF);
				parameter<bool> ok_idem  := abs(uiA - utA) <= utA * relTolF;
				parameter<bool> ok_split := suN > uint32(0) && suN <= #Elems;
				parameter<bool> ok_dev   := devVsGeos <= relTolF * 100.0;
				parameter<bool> ok := ok_area && ok_idem && ok_split && ok_dev;
				parameter<string> failwhat :=
					(ok_area ? '' : 'area-sum ') + (ok_idem ? '' : 'idempotence ') + (ok_split ? '' : 'split-count ') + (ok_dev ? '' : 'area-vs-geos ');
			}
		}

		container ManySmall := Scenario_T(../ManySmall/Cells, ../ManySmall/Parts, ../ManySmall/geometry, ../ManySmall/geometry_i, ../ManySmall/Cells/part_rel, ../ManySmall/sumA, Parameters/relTol, 1e6);
		container FewLarge  := Scenario_T(../FewLarge/Polys, ../FewLarge/Parts, ../FewLarge/geometry, ../FewLarge/geometry_i, ../FewLarge/Polys/part_rel, ../FewLarge/sumA, Parameters/relTol, 1e6);

		// echte-datascenario's (alleen berekend via results/real); gemeenten in cm
		container GemReal    := Scenario_T(../RealData/Gemeenten/Elems, ../RealData/Gemeenten/Parts, ../RealData/Gemeenten/geometry, ../RealData/Gemeenten/geometry_i, ../RealData/Gemeenten/part_rel, ../RealData/Gemeenten/sumA, Parameters/relTol, 1.0);
		container PandenReal := Scenario_T(../RealData/PandenAms/Elems, ../RealData/PandenAms/Parts, ../RealData/PandenAms/geometry, ../RealData/PandenAms/geometry_i, ../RealData/PandenAms/part_rel, ../RealData/PandenAms/sumA, Parameters/relTol, 1.0);
	}

	// Een gezamenlijke uitslag voor de vier families: per familie een eigen tagregel
	// (status, uniearealen en afwijking t.o.v. geos), een <failing>-regel met de
	// falende familie-scenario-combinaties, en een EN-oordeel over alles.
	container results
	{
		parameter<string> results_folder_filename := '%LocalDataDir%/Regression/log/results_folder.txt';
		parameter<string> results_folder : Storagename = "= results_folder_filename", StorageType = "str";

		// Een regel per familie: OK, of FAILS met de gefaalde invariant(en) en het
		// scenario erbij. Alleen de geos-regel draagt de uniearealen (het exacte
		// anker voor versievergelijking); verdere getallen staan bewust NIET in de
		// cel - het oordeel komt uit ALLE invarianten, niet alleen het union-areaal.
		Template FamLine_T
		{
			parameter<string> famName;
			parameter<string> dispName;
			parameter<bool>   okMS;
			parameter<bool>   okFL;
			parameter<string> fwMS;
			parameter<string> fwFL;
			//
			parameter<bool>   ok := okMS && okFL;
			parameter<string> line :=
				'<' + famName + '>&bull; ' + dispName + ': ' + (ok ? 'OK'
					: 'FAILS (' + (okMS ? '' : 'ManySmall: ' + fwMS) + (okFL ? '' : 'FewLarge: ' + fwFL) + ')')
				+ '</' + famName + '>';
			parameter<string> failnote :=
				(okMS ? '' : famName + '-ManySmall; ') + (okFL ? '' : famName + '-FewLarge; ');
		}
		// een oordeel per familie over ALLE scenario's (synthetisch en praktijkdata
		// zijn gewoon testgevallen); een FAILS benoemt scenario + invariant
		Template FamAll_T
		{
			parameter<string> famName;   // tagnaam (klein)
			parameter<string> dispName;  // weergavenaam in de regel
			parameter<bool>   okMS;
			parameter<bool>   okFL;
			parameter<bool>   okGem;
			parameter<bool>   okPand;
			parameter<string> fwMS;
			parameter<string> fwFL;
			parameter<string> fwGem;
			parameter<string> fwPand;
			//
			parameter<bool>   ok := okMS && okFL && okGem && okPand;
			parameter<string> line :=
				'<' + famName + '>&bull; ' + dispName + ': ' + (ok ? 'OK'
					: 'FAILS ('
						+ (okMS   ? '' : 'ManySmall: ' + fwMS)
						+ (okFL   ? '' : 'FewLarge: ' + fwFL)
						+ (okGem  ? '' : 'municipalities: ' + fwGem)
						+ (okPand ? '' : 'buildings: ' + fwPand) + ')')
				+ '</' + famName + '>';
			parameter<string> failnote :=
				  (okMS   ? '' : famName + '-ManySmall; ') + (okFL ? '' : famName + '-FewLarge; ')
				+ (okGem  ? '' : famName + '-municipalities; ') + (okPand ? '' : famName + '-buildings; ');
		}

		container geos := FamLine_T('geos', 'Geos', Ops/ManySmall/geos/ok, Ops/FewLarge/geos/ok, Ops/ManySmall/geos/failwhat, Ops/FewLarge/geos/failwhat);
		container bg   := FamLine_T('bg',   'Bg',   Ops/ManySmall/bg/ok,   Ops/FewLarge/bg/ok,   Ops/ManySmall/bg/failwhat,   Ops/FewLarge/bg/failwhat);
		container bp   := FamLine_T('bp',   'Bp',   Ops/ManySmall/bp/ok,   Ops/FewLarge/bp/ok,   Ops/ManySmall/bp/failwhat,   Ops/FewLarge/bp/failwhat);
		container cgal := FamLine_T('cgal', 'CGAL', Ops/ManySmall/cgal/ok, Ops/FewLarge/cgal/ok, Ops/ManySmall/cgal/failwhat, Ops/FewLarge/cgal/failwhat);
		// geos-anker: exacte arealen, zodat elke versieafwijking oplicht in de diff
		parameter<string> anchor_line :=
			'<anchor>geos union area: ManySmall ' + string(float32(Ops/ManySmall/geos/uA)) + ' m2, FewLarge ' + string(float32(Ops/FewLarge/geos/uA)) + ' m2</anchor>';

		// de ringformaat-bewakers zijn synthetisch en draaien dus in beide uitslagen mee;
		// ze zijn stil zolang ze slagen, net als de issue-882-repro
		parameter<bool>   syntOk      := geos/ok && bg/ok && bp/ok && cgal/ok && /ring_encoding/ok;
		parameter<string> syntFailing := geos/failnote + bg/failnote + bp/failnote + cgal/failnote + /ring_encoding/failnote;
		parameter<string> syntLines   := anchor_line + geos/line + bg/line + bp/line + cgal/line + /ring_encoding/line;

		// synthetisch-only uitslag: voor machines zonder de echte databronnen
		container all
		{
			parameter<string> result :=
				'<description>polygon family compare (geos/bg/bp/cgal), synthetic data only</description>'
				+ syntLines
				+ (syntFailing == '' ? '' : '<failing>' + syntFailing + '</failing>')
				+ '<result>' + (syntOk ? 'OK' : 'False') + '</result>';
			parameter<string> stored_result := result, StorageType = "str", Storagename = "= results_folder + '/t020_polygons.txt'";
		}

		// gecombineerde uitslag (EEN t020): een oordeel per familie over alle
		// scenario's, met de geos-arealen van alle scenario's als anker.
		// Bekende, als GeoDMS-issue geregistreerde gebreken tellen als expliciete
		// skip-met-issuelink en niet als rood (beleid Jip: een longstanding issue
		// mag de release niet ophouden; de link houdt het zichtbaar en traceerbaar).
		container combined
		{
			parameter<string> anchor_all :=
				'<anchor>geos union area: ManySmall ' + string(float32(Ops/ManySmall/geos/uA)) + ' m2, FewLarge ' + string(float32(Ops/FewLarge/geos/uA))
				+ ' m2, Mun. NH ' + string(float32(Ops/GemReal/geos/utA)) + ' m2, Buildings AMS ' + string(float32(Ops/PandenReal/geos/utA)) + ' m2</anchor>';

			container geos_c := FamAll_T('geos', 'Geos', Ops/ManySmall/geos/ok, Ops/FewLarge/geos/ok, Ops/GemReal/geos/ok, Ops/PandenReal/geos/ok,
				Ops/ManySmall/geos/failwhat, Ops/FewLarge/geos/failwhat, Ops/GemReal/geos/failwhat, Ops/PandenReal/geos/failwhat);
			// bg: het pandendeel blijft geskipt (issue 1176). De engine-crash zelf is weg -
			// bg_union_polygon gaf ongeldige geometrie door aan boost::geometry (undefined
			// behaviour) en meldt nu een nette [E] - maar op deze panden lukt de reparatie
			// nog steeds niet, dus de union komt er niet doorheen. Het item wordt bewust
			// niet aangeroepen: de fout zou de hele t020-run laten falen.
			container bg_c
			{
				parameter<bool>   ok := Ops/ManySmall/bg/ok && Ops/FewLarge/bg/ok && Ops/GemReal/bg/ok;
				parameter<string> line :=
					'<bg>&bull; Bg: ' + (ok ? 'OK'
						: 'FAILS ('
							+ (Ops/ManySmall/bg/ok ? '' : 'ManySmall: ' + Ops/ManySmall/bg/failwhat)
							+ (Ops/FewLarge/bg/ok  ? '' : 'FewLarge: ' + Ops/FewLarge/bg/failwhat)
							+ (Ops/GemReal/bg/ok   ? '' : 'municipalities: ' + Ops/GemReal/bg/failwhat) + ')')
					+ '; buildings skipped (bg_union_polygon cannot repair the input, GeoDMS <a href=https://github.com/ObjectVision/GeoDMS/issues/1176>#1176</a>)</bg>';
				parameter<string> failnote :=
					  (Ops/ManySmall/bg/ok ? '' : 'bg-ManySmall; ') + (Ops/FewLarge/bg/ok ? '' : 'bg-FewLarge; ')
					+ (Ops/GemReal/bg/ok ? '' : 'bg-municipalities; ');
			}
			container bp_c := FamAll_T('bp', 'Bp', Ops/ManySmall/bp/ok, Ops/FewLarge/bp/ok, Ops/GemReal/bp/ok, Ops/PandenReal/bp/ok,
				Ops/ManySmall/bp/failwhat, Ops/FewLarge/bp/failwhat, Ops/GemReal/bp/failwhat, Ops/PandenReal/bp/failwhat);
			// cgal: het ~0,3%-oppervlakteverlies op de panden zat in de multi-polygoon-
			// LEZER (elk gat werd van de hele verzameling afgetrokken in plaats van van
			// de polygoon waar het gat bij hoort, zie ring_encoding/island_in_hole), niet
			// in de union. Geregistreerd als GeoDMS #1178 en gefixt vanaf 20.13; daaronder
			// is de idempotentietoets op de panden een expliciete skip met issueverwijzing
			// -- bekende engine-issues parkeren we, we laten ze niet rood staan. De overige
			// panden-invarianten tellen wel gewoon mee, zodat nieuwe cgal-breuk opvalt.
			container cgal_c
			{
				parameter<bool>   idemFixed := GeoDmsVersion() >= 20.13;
				parameter<bool>   okPand    := idemFixed
					? Ops/PandenReal/cgal/ok
					: Ops/PandenReal/cgal/ok_area && Ops/PandenReal/cgal/ok_split && Ops/PandenReal/cgal/ok_dev;
				parameter<string> fwPand    := idemFixed
					? Ops/PandenReal/cgal/failwhat
					: (Ops/PandenReal/cgal/ok_area ? '' : 'area-sum ') + (Ops/PandenReal/cgal/ok_split ? '' : 'split-count ') + (Ops/PandenReal/cgal/ok_dev ? '' : 'area-vs-geos ');
				parameter<bool>   ok := Ops/ManySmall/cgal/ok && Ops/FewLarge/cgal/ok && Ops/GemReal/cgal/ok && okPand;
				parameter<string> line :=
					'<cgal>&bull; CGAL: ' + (ok ? 'OK'
						: 'FAILS ('
							+ (Ops/ManySmall/cgal/ok ? '' : 'ManySmall: ' + Ops/ManySmall/cgal/failwhat)
							+ (Ops/FewLarge/cgal/ok  ? '' : 'FewLarge: ' + Ops/FewLarge/cgal/failwhat)
							+ (Ops/GemReal/cgal/ok   ? '' : 'municipalities: ' + Ops/GemReal/cgal/failwhat)
							+ (okPand                ? '' : 'buildings: ' + fwPand) + ')')
					+ (idemFixed ? '' : '; buildings idempotence check skipped (known ~0.3% area loss, GeoDMS <a href=https://github.com/ObjectVision/GeoDMS/issues/1178>#1178</a>)')
					+ '</cgal>';
				parameter<string> failnote :=
					  (Ops/ManySmall/cgal/ok ? '' : 'cgal-ManySmall; ') + (Ops/FewLarge/cgal/ok ? '' : 'cgal-FewLarge; ')
					+ (Ops/GemReal/cgal/ok ? '' : 'cgal-municipalities; ') + (okPand ? '' : 'cgal-buildings; ');
			}

			// regressiewacht op de gefixte issue-882 (infix-union op de originele
			// probleemgeometrie); stil zolang hij slaagt, een regel zodra hij faalt
			container i882
			{
				unit<uint32> two: nrofrows = 2;
				attribute<dpoint> geoms (two, polygon) := union_data(two, /issue_882/p1/geo0, /issue_882/p2/geo0);
				attribute<dpoint> secs  (two, polygon) := union_data(two, /issue_882/s1, /issue_882/s2);
				parameter<float64> aU  := area(/issue_882/union_gone, m2u);
				parameter<float64> aG  := area(geos_union_polygon(geoms), m2u);
				parameter<float64> aS  := area(/issue_882/section_gone, m2u);
				parameter<float64> aSG := area(geos_union_polygon(secs), m2u);
				parameter<bool> ok_union   := abs(aU - aG)  <= aG  * 1e-6;
				parameter<bool> ok_section := abs(aS - aSG) <= aSG * 1e-6;
				parameter<string> line := ok_union && ok_section
					? ''
					: '<i882>issue-882 repro: FAILS; union infix ' + string(float32(aU)) + ' vs geos ' + string(float32(aG))
						+ '; section infix ' + string(float32(aS)) + ' vs geos ' + string(float32(aSG)) + '</i882>';
				parameter<string> failnote :=
					(ok_union ? '' : 'i882-union; ') + (ok_section ? '' : 'i882-section; ');
			}

			parameter<bool>   allOk   := geos_c/ok && bg_c/ok && bp_c/ok && cgal_c/ok && i882/ok_union && i882/ok_section && /ring_encoding/ok;
			parameter<string> failing := geos_c/failnote + bg_c/failnote + bp_c/failnote + cgal_c/failnote + i882/failnote + /ring_encoding/failnote;
			parameter<string> result :=
				'<description>polygon family compare: synthetic scenarios + CBS/BAG data</description>'
				+ anchor_all
				+ geos_c/line + bg_c/line + bp_c/line + cgal_c/line + i882/line + /ring_encoding/line
				+ (failing == '' ? '' : '<failing>' + failing + '</failing>')
				+ '<result>' + (allOk ? 'OK' : 'False') + '</result>';
			parameter<string> stored_result := result, StorageType = "str", Storagename = "= results_folder + '/t020_polygons.txt'";

			// --- structured MEASUREMENT (batch/TEST_OUTPUT_STANDARD.md) ---
			// De geos-unie-arealen zijn de te bewaken waarden: geos is de referentie
			// waar de andere families tegen worden afgezet, dus als die verschuiven is
			// de hele vergelijking verschoven. Het rapport oordeelt (references.json).
			// De per-familie-regels reizen als notes mee zodat de cel dezelfde vorm
			// houdt: een gevonden .json vervangt de legacy .txt volledig.
			// Alleen container combined emit JSON -- onder 20.3 draait results/all, een
			// andere (synthetisch-only) meting die niet met deze waarden vergelijkbaar is.
			container m_ms  := TestResult/metric_value('geos ManySmall',      'm2', string(Ops/ManySmall/geos/uA));
			container m_fl  := TestResult/metric_value('geos FewLarge',       'm2', string(Ops/FewLarge/geos/uA));
			container m_gem := TestResult/metric_value('geos municipalities', 'm2', string(Ops/GemReal/geos/utA));
			container m_pnd := TestResult/metric_value('geos buildings',      'm2', string(Ops/PandenReal/geos/utA));

			Template Note_T
			{
				parameter<string> key;
				parameter<string> line;
				parameter<bool>   ok;
				// de familieregel zit in <key>...</key>; die wrapper hoort niet in de
				// note-tekst, het rapport zet de regel zelf neer
				parameter<string> text   := replace(replace(line, '<' + key + '>', ''), '</' + key + '>', '');
				parameter<string> result := '{"key":"' + key + '","text":"' + text + '","ok":' + (ok ? 'true' : 'false') + '}';
			}
			container n_geos := Note_T('geos', geos_c/line, geos_c/ok);
			container n_bg   := Note_T('bg',   bg_c/line,   bg_c/ok);
			container n_bp   := Note_T('bp',   bp_c/line,   bp_c/ok);
			container n_cgal := Note_T('cgal', cgal_c/line, cgal_c/ok);
			// ring_encoding zit wel in allOk van de legacy .txt, maar het rapport geeft
			// de .json voorrang: zonder deze note zou een falende ringformaat-bewaker
			// nergens meer opduiken. Net als i882 alleen een regel zodra hij faalt.
			container n_ringenc := Note_T('ringenc', /ring_encoding/line, /ring_encoding/ok);

			parameter<string> anchor_text := replace(replace(anchor_all, '<anchor>', ''), '</anchor>', '');

			parameter<string> result_json :=
				'{"schema":2,"test":"t020","kind":"reference_comparison"'
				+ ',"title":"Polygon family compare (geos/bg/bp/cgal)"'
				+ ',"compared":"union invariants on synthetic scenarios and on CBS/BAG data"'
				+ ',"reference":{"source":"inline","compare":"scalar"}'
				// de ankerregel in notes toont deze waarden al; een regel per metric
				// zou dubbelop zijn, dus alleen tonen zodra er iets afwijkt
				+ ',"metrics_display":"on_deviation"'
				+ ',"metrics":[' + m_ms/result + ',' + m_fl/result + ',' + m_gem/result + ',' + m_pnd/result + ']'
				+ ',"notes":[{"key":"anchor","text":"' + anchor_text + '","ok":true}'
				+ ',' + n_geos/result + ',' + n_bg/result + ',' + n_bp/result + ',' + n_cgal/result
				+ (i882/line == '' ? '' : ',{"key":"i882","text":"issue-882 repro: FAILS","ok":false}')
				+ (/ring_encoding/line == '' ? '' : ',' + n_ringenc/result)
				+ ']}'
			,	StorageType = "str"
			,	Storagename = "= results_folder + '/t020_polygons.result.json'";
		}
	}
}

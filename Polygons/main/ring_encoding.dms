////////////////////////////////////////////////////////////////////////////////
// Synthetische bewakers op het DMS multi-polygoon-ringformaat.
//
// Een dpolygon-sequence codeert een multi-polygoon als EEN puntenreeks: buitenring
// met de klok mee, binnenringen tegen de klok in, en deelpolygonen aan elkaar
// geregen met terugkeerpunten (bridges). Elke geometriefamilie leest dat formaat
// met een eigen parser, en juist daar zaten de fouten uit issue 1176/1178 - niet
// in de union zelf. Deze reeksen zijn met de hand geschreven zodat de parser
// exact getest wordt; ze zijn klein, deterministisch en hebben GEEN SourceData
// nodig, dus ze draaien ook op machines zonder de BAG/CBS-bronnen.
//
// Alleen de float64-families (geos/bg/cgal) staan hier: het gaat om het lezen van
// de puntenreeks, en bp heeft een eigen integer-pijplijn die al door de
// ManySmall/FewLarge/gemeenten/panden-scenario's gedekt wordt.
////////////////////////////////////////////////////////////////////////////////

container ring_encoding
{
	unit<dpoint> crd := range(dpoint, point_yx(-100.0, -100.0), point_yx(100.0, 100.0));

	// -------------------------------------------------------------------------
	// island_in_hole (GeoDMS issue 1178)
	//
	// Een vierkant van 10x10 met een gat van 6x6, en IN dat gat een los eiland van
	// 2x2 - de vorm van een bouwblok met een schuurtje op de binnenplaats. Opgeschreven
	// zoals de engine zelf een multi-polygoon wegschrijft:
	//   buitenring(gesloten) gat(gesloten) buitenring[0] eiland(gesloten) buitenring[0]
	// Oppervlak = 100 - 36 + 4 = 68.
	//
	// De cgal-lezer trok elk gat van de HELE verzameling af in plaats van van de
	// polygoon waar het gat bij hoort, waardoor het eiland verdween (64 i.p.v. 68).
	// Op de echte panden kostte dat 0,29% oppervlak in de idempotentietoets.
	// -------------------------------------------------------------------------
	container island_in_hole
	{
		unit<uint32> pnt := range(uint32, 0, 17)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy( 0.0, 10.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0,  0.0)
			,	point_xy( 2.0,  2.0), point_xy( 8.0,  2.0), point_xy( 8.0,  8.0), point_xy( 2.0,  8.0), point_xy( 2.0,  2.0)
			,	point_xy( 0.0,  0.0)
			,	point_xy( 4.0,  4.0), point_xy( 4.0,  6.0), point_xy( 6.0,  6.0), point_xy( 6.0,  4.0), point_xy( 4.0,  4.0)
			,	point_xy( 0.0,  0.0)
			);
		}
		parameter<crd> geo (polygon) := points2polygon(pnt/xy);

		unit<uint32> one : nrofrows = 1;
		attribute<crd> geoms (one, polygon) := union_data(one, geo);

		// het invoeroppervlak zelf (schoenveterformule over de reeks) is de referentie:
		// de invoer is een geldige multi-polygoon, dus elke union ervan moet hem opleveren
		parameter<float64> aIn   := area(geo, m2u);
		parameter<float64> aGeos := area(geos_union_polygon(geoms), m2u);
		parameter<float64> aBg   := area(bg_union_polygon(geoms), m2u);
		parameter<float64> aCgal := area(cgal_union_polygon(geoms), m2u);

		parameter<bool> ok_geos := abs(aGeos - aIn) <= aIn * 1e-6;
		parameter<bool> ok_bg   := abs(aBg   - aIn) <= aIn * 1e-6;
		parameter<bool> ok_cgal := abs(aCgal - aIn) <= aIn * 1e-6;
		// De cgal-tak is GeoDMS #1178: de lezer trok elk gat van de hele verzameling af
		// in plaats van van de polygoon waar het gat bij hoort, waardoor een eiland in
		// een gat verdween. Gefixt vanaf 20.13; daaronder een expliciete skip met
		// issueverwijzing in plaats van rood. geos en bg blijven wel bewaakt.
		parameter<bool> cgalIdemFixed := GeoDmsVersion() >= 20.13;
		parameter<bool> ok := ok_geos && ok_bg && (cgalIdemFixed ? ok_cgal : true);
		parameter<string> failwhat :=
			(ok_geos ? '' : 'geos ' + string(float32(aGeos)) + ' ') + (ok_bg ? '' : 'bg ' + string(float32(aBg)) + ' ')
			+ (ok_cgal ? '' : 'cgal ' + string(float32(aCgal)) + ' ');
	}

	// -------------------------------------------------------------------------
	// overlapping_outers (GeoDMS issue 1176)
	//
	// Twee ELKAAR OVERLAPPENDE buitenringen in dezelfde reeks: ongeldige invoer, die
	// elke familie eerst moet repareren voordat er geunieerd kan worden. Er is geen
	// principieel juist antwoord voor ongeldige invoer, dus dit is bewust een
	// consistentietoets: de reparatiepaden van geos en bg (beide via GEOS MakeValid)
	// horen hetzelfde te zeggen. bg gaf hier vroeger ongeldige geometrie door aan
	// boost::geometry, wat undefined behaviour is en de engine kon killen.
	// -------------------------------------------------------------------------
	container overlapping_outers
	{
		unit<uint32> pntA := range(uint32, 0, 11)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy( 0.0, 10.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0,  0.0)
			,	point_xy( 5.0,  5.0), point_xy( 5.0, 15.0), point_xy(15.0, 15.0), point_xy(15.0,  5.0), point_xy( 5.0,  5.0)
			,	point_xy( 0.0,  0.0)
			);
		}
		unit<uint32> pntB := range(uint32, 0, 5)
		{
			attribute<crd> xy := union_data(.
			,	point_xy(20.0, 20.0), point_xy(20.0, 30.0), point_xy(30.0, 30.0), point_xy(30.0, 20.0), point_xy(20.0, 20.0)
			);
		}
		parameter<crd> geoA (polygon) := points2polygon(pntA/xy);
		parameter<crd> geoB (polygon) := points2polygon(pntB/xy);

		unit<uint32> two : nrofrows = 2;
		attribute<crd> geoms (two, polygon) := union_data(two, geoA, geoB);

		parameter<float64> aGeos := area(geos_union_polygon(geoms), m2u);
		parameter<float64> aBg   := area(bg_union_polygon(geoms), m2u);

		parameter<bool> ok := abs(aBg - aGeos) <= aGeos * 1e-6;
		parameter<string> failwhat := ok ? '' : 'bg ' + string(float32(aBg)) + ' vs geos ' + string(float32(aGeos)) + ' ';
	}

	// -------------------------------------------------------------------------
	// infix (GeoDMS issue 882 / 1176)
	//
	// De infixoperatoren +, * en - op dpolygon zijn geregistreerd op dezelfde
	// operator als geos_union / geos_intersect / geos_difference; ze horen dus per
	// constructie hetzelfde te geven. Twee overlappende vierkanten van 10x10:
	// 175 / 25 / 75 m2.
	// -------------------------------------------------------------------------
	container infix
	{
		parameter<crd> geoA (polygon) := ../overlapping_outers/geoB;
		unit<uint32> pntC := range(uint32, 0, 5)
		{
			attribute<crd> xy := union_data(.
			,	point_xy(25.0, 25.0), point_xy(25.0, 35.0), point_xy(35.0, 35.0), point_xy(35.0, 25.0), point_xy(25.0, 25.0)
			);
		}
		parameter<crd> geoC (polygon) := points2polygon(pntC/xy);

		parameter<float64> aAddInfix := area(geoA + geoC, m2u);
		parameter<float64> aAddNamed := area(geos_union(geoA, geoC), m2u);
		parameter<float64> aMulInfix := area(geoA * geoC, m2u);
		parameter<float64> aMulNamed := area(geos_intersect(geoA, geoC), m2u);
		parameter<float64> aSubInfix := area(geoA - geoC, m2u);
		parameter<float64> aSubNamed := area(geos_difference(geoA, geoC), m2u);

		parameter<bool> ok_add := abs(aAddInfix - aAddNamed) <= aAddNamed * 1e-6;
		parameter<bool> ok_mul := abs(aMulInfix - aMulNamed) <= aMulNamed * 1e-6;
		parameter<bool> ok_sub := abs(aSubInfix - aSubNamed) <= aSubNamed * 1e-6;
		parameter<bool> ok := ok_add && ok_mul && ok_sub;
		parameter<string> failwhat :=
			(ok_add ? '' : 'add ' + string(float32(aAddInfix)) + '!=' + string(float32(aAddNamed)) + ' ')
			+ (ok_mul ? '' : 'mul ' + string(float32(aMulInfix)) + '!=' + string(float32(aMulNamed)) + ' ')
			+ (ok_sub ? '' : 'sub ' + string(float32(aSubInfix)) + '!=' + string(float32(aSubNamed)) + ' ');
	}


	// -------------------------------------------------------------------------
	// winding_order (GeoDMS issue 302)
	//
	// De ringvolgorde-operatoren, op dezelfde vorm als island_in_hole hierboven: een
	// buitenring van 10x10, een gat van 6x6 en een eiland van 2x2 in dat gat, samen
	// 68 m2, maar met telkens een andere ring omgedraaid.
	//
	// Waarom area(g) < 0 hier niet volstaat: area telt de HELE reeks als een getekend
	// totaal op, dus alleen een feature waarvan ALLE ringen omgedraaid zijn wordt
	// negatief. Draait er maar een om, dan wordt het totaal juist te GROOT
	// (100 + 36 + 4 = 140) en glipt het door de test heen. Precies dat geval hield
	// jipclaassens in issue 302 over in de BAG rond Amsterdam, na partitioned_union_polygon.
	//
	// De lezers leiden de rol van een ring af uit zijn ORIENTATIE; fix_winding_order
	// leidt hem af uit de NESTING en past daarna pas de conventie toe. Alleen dat
	// repareert een half omgedraaid feature.
	// -------------------------------------------------------------------------
	container winding_order
	{
		// goed: buitenring met de klok mee, gat tegen de klok in, eiland met de klok mee
		unit<uint32> pOk := range(uint32, 0, 17)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy( 0.0, 10.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0,  0.0)
			,	point_xy( 2.0,  2.0), point_xy( 8.0,  2.0), point_xy( 8.0,  8.0), point_xy( 2.0,  8.0), point_xy( 2.0,  2.0)
			,	point_xy( 0.0,  0.0)
			,	point_xy( 4.0,  4.0), point_xy( 4.0,  6.0), point_xy( 6.0,  6.0), point_xy( 6.0,  4.0), point_xy( 4.0,  4.0)
			,	point_xy( 0.0,  0.0)
			);
		}
		// alleen het GAT omgedraaid: 100 + 36 + 4 = 140, dus niet negatief
		unit<uint32> pMixed := range(uint32, 0, 17)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy( 0.0, 10.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0,  0.0)
			,	point_xy( 2.0,  2.0), point_xy( 2.0,  8.0), point_xy( 8.0,  8.0), point_xy( 8.0,  2.0), point_xy( 2.0,  2.0)
			,	point_xy( 0.0,  0.0)
			,	point_xy( 4.0,  4.0), point_xy( 4.0,  6.0), point_xy( 6.0,  6.0), point_xy( 6.0,  4.0), point_xy( 4.0,  4.0)
			,	point_xy( 0.0,  0.0)
			);
		}
		// alleen het EILAND omgedraaid: 100 - 36 - 4 = 60. Pint de pariteitsregel op diepte 2.
		unit<uint32> pIsland := range(uint32, 0, 17)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy( 0.0, 10.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0,  0.0)
			,	point_xy( 2.0,  2.0), point_xy( 8.0,  2.0), point_xy( 8.0,  8.0), point_xy( 2.0,  8.0), point_xy( 2.0,  2.0)
			,	point_xy( 0.0,  0.0)
			,	point_xy( 4.0,  4.0), point_xy( 6.0,  4.0), point_xy( 6.0,  6.0), point_xy( 4.0,  6.0), point_xy( 4.0,  4.0)
			,	point_xy( 0.0,  0.0)
			);
		}
		// een strik: een zichzelf snijdende ring, kruising in (5,5). Het getekende
		// oppervlak is exact 0, dus er valt geen enkele orientatie uit af te lezen.
		// De twee lobben zijn samen 50 m2, en dat komt er pas uit na fix_polygon.
		unit<uint32> pBow := range(uint32, 0, 5)
		{
			attribute<crd> xy := union_data(.
			,	point_xy( 0.0,  0.0), point_xy(10.0, 10.0), point_xy(10.0,  0.0), point_xy( 0.0, 10.0), point_xy( 0.0,  0.0)
			);
		}

		parameter<crd> gOk     (polygon) := points2polygon(pOk/xy);
		parameter<crd> gAllRev (polygon) := reverse_polygon(gOk);
		parameter<crd> gMixed  (polygon) := points2polygon(pMixed/xy);
		parameter<crd> gIsland (polygon) := points2polygon(pIsland/xy);
		parameter<crd> gBow    (polygon) := points2polygon(pBow/xy);

		parameter<float64> aIn := area(gOk, m2u);

		// reverse_polygon draait elke RING om en laat de reeksindeling staan. Een omkering
		// van de hele reeks - wat de sequence2points/reverse/points2sequence-workaround uit
		// issue 302 doet - zou de ringstructuur slopen en deze heen-en-weertoets laten zakken.
		unit<uint32> sOk   := sequence2points(gOk)                      { attribute<string> s := string(point); }
		unit<uint32> sBack := sequence2points(reverse_polygon(gAllRev)) { attribute<string> s := string(point); }
		parameter<bool> ok_roundtrip := AsDataString(sBack/s) == AsDataString(sOk/s);
		parameter<bool> ok_negate    := area(gAllRev, m2u) == -aIn;

		// fix_winding_order leidt de ringrollen af uit de nesting, dus alle vier de
		// varianten moeten op het oppervlak van de schone vorm uitkomen.
		parameter<float64> fOk     := area(fix_winding_order(gOk),     m2u);
		parameter<float64> fAllRev := area(fix_winding_order(gAllRev), m2u);
		parameter<float64> fMixed  := area(fix_winding_order(gMixed),  m2u);
		parameter<float64> fIsland := area(fix_winding_order(gIsland), m2u);

		parameter<bool> ok_fix :=
			   abs(fOk     - aIn) <= aIn * 1e-6
			&& abs(fAllRev - aIn) <= aIn * 1e-6
			&& abs(fMixed  - aIn) <= aIn * 1e-6
			&& abs(fIsland - aIn) <= aIn * 1e-6;

		// het half omgedraaide geval is juist te GROOT, niet negatief: de oude toets mist hem
		parameter<bool> ok_area_blind := area(gMixed, m2u) > aIn;

		// has_correct_winding keurt alleen de schone vorm goed
		parameter<bool> ok_predicate :=
			   has_correct_winding(gOk)
			&& !has_correct_winding(gAllRev)
			&& !has_correct_winding(gMixed)
			&& !has_correct_winding(gIsland)
			&& !has_correct_winding(gBow);

		// fix_polygon repareert de strik tot twee lobben van 25 m2; fix_winding_order
		// raakt hem niet aan, want daarvoor moeten er coordinaten verschuiven.
		parameter<float64> fBow    := area(fix_polygon(gBow), m2u);
		parameter<float64> wBow    := area(fix_winding_order(gBow), m2u);
		parameter<bool> ok_bowtie  := abs(fBow - 50.0) <= 1e-6 && wBow == 0.0;

		// De lezers leiden de ringrol af uit de ORIENTATIE, maar RELATIEF: de eerste ring die
		// overleeft bepaalt wat 'buiten' betekent voor dat feature (GeoDMS issue 1212).
		// Daardoor komt een volledig omgedraaid feature bij alle drie de families met de
		// juiste topologie binnen. Voor 1212 keken geos en cgal ABSOLUUT - buiten is met de
		// klok mee - en viel de CCW-buitenring weg terwijl er nog geen polygoon open stond,
		// waarna het gat tot buitenring gepromoveerd werd: 36 - 4 = 32 in plaats van 68,
		// zonder enige melding. geos en cgal normaliseren de winding van hun resultaat,
		// bg laat de vorm staan zoals hij binnenkwam en geeft -68; vandaar de abs() daar.
		parameter<float64> rGeos := area(geos_polygon(gAllRev), m2u);
		parameter<float64> rCgal := area(cgal_polygon(gAllRev), m2u);
		parameter<float64> rBg   := area(bg_polygon(gAllRev),   m2u);

		parameter<bool> ok_readers :=
			   abs(rGeos      - aIn) <= aIn * 1e-6
			&& abs(rCgal      - aIn) <= aIn * 1e-6
			&& abs(abs(rBg)   - aIn) <= aIn * 1e-6;

		parameter<bool> ok := ok_roundtrip && ok_negate && ok_fix && ok_area_blind && ok_predicate && ok_bowtie && ok_readers;
		parameter<string> failwhat :=
			  (ok_roundtrip  ? '' : 'roundtrip ')
			+ (ok_negate     ? '' : 'negate ')
			+ (ok_fix        ? '' : 'fix ' + string(float32(fOk)) + '/' + string(float32(fAllRev)) + '/' + string(float32(fMixed)) + '/' + string(float32(fIsland)) + ' ')
			+ (ok_area_blind ? '' : 'area-blind ')
			+ (ok_predicate  ? '' : 'predicate ')
			+ (ok_bowtie     ? '' : 'bowtie ' + string(float32(fBow)) + '/' + string(float32(wBow)) + ' ')
			+ (ok_readers    ? '' : 'readers ' + string(float32(rGeos)) + '/' + string(float32(rCgal)) + '/' + string(float32(rBg)) + ' ');
	}

	parameter<bool>   ok := island_in_hole/ok && overlapping_outers/ok && infix/ok && winding_order/ok;
	parameter<string> line := ok
		? (island_in_hole/cgalIdemFixed ? ''
			: '<ringenc>ring encoding: cgal island-in-hole skipped (known ~0.3% area loss, GeoDMS <a href=https://github.com/ObjectVision/GeoDMS/issues/1178>#1178</a>)</ringenc>')
		: '<ringenc>ring encoding: FAILS ('
			+ (island_in_hole/ok     ? '' : 'island-in-hole: ' + island_in_hole/failwhat)
			+ (overlapping_outers/ok ? '' : 'overlapping-outers: ' + overlapping_outers/failwhat)
			+ (infix/ok              ? '' : 'infix: ' + infix/failwhat)
			+ (winding_order/ok      ? '' : 'winding-order: ' + winding_order/failwhat) + ')</ringenc>';
	parameter<string> failnote :=
		  (island_in_hole/ok     ? '' : 'ringenc-island-in-hole; ')
		+ (overlapping_outers/ok ? '' : 'ringenc-overlapping-outers; ')
		+ (infix/ok              ? '' : 'ringenc-infix; ')
		+ (winding_order/ok      ? '' : 'ringenc-winding-order; ');
}

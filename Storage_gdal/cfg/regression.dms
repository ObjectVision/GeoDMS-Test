				attribute<bool>           test_seq   (pointset)   := pointset/sequence_rel ==  union_data(pointset, /EsriShape/polygon/reference/sequence);
				attribute<bool>           test_ord   (pointset)   := pointset/ordinal ==  union_data(pointset, /EsriShape/polygon/reference/ordinal);

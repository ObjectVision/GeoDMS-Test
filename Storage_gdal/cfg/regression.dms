				unit<spoint> nl_lu_2010
				: StorageName     = "%localDataProjDir%/regr_results/gdal_grid/bmp/gdal_nl_lu_2010.bmp"
				, StorageType     = "gdal.grid"
				, DialogData      = "units/point_rd"
				, StorageReadOnly = "True"
				{
					attribute<cl_lu>  GridData;
				}
